#!/usr/bin/env bash

set -euo pipefail

if command -v clang-format-21 >/dev/null 2>&1; then
  CLANG_FORMAT_BIN="clang-format-21"
elif command -v clang-format >/dev/null 2>&1; then
  CLANG_FORMAT_BIN="clang-format"
else
  echo "clang-format 21 or newer is required" >&2
  exit 1
fi

version="$(${CLANG_FORMAT_BIN} --version)"
major="$(printf '%s\n' "$version" | grep -oE '[0-9]+' | head -n1)"
if [[ -z "$major" || "$major" -lt 21 ]]; then
  echo "${CLANG_FORMAT_BIN} is too old: ${version}" >&2
  exit 1
fi

head_revision="${GITHUB_SHA:-HEAD}"
base_revision=""
if [[ -n "${GITHUB_EVENT_PATH:-}" && -f "$GITHUB_EVENT_PATH" ]]; then
  base_revision="$(python3 - "$GITHUB_EVENT_PATH" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as source:
    event = json.load(source)
print(event.get("pull_request", {}).get("base", {}).get("sha") or event.get("before", ""))
PY
)"
fi

zero_revision="0000000000000000000000000000000000000000"
if [[ -z "$base_revision" || "$base_revision" == "$zero_revision" ]] ||
  ! git cat-file -e "${base_revision}^{commit}" 2>/dev/null; then
  if git rev-parse "${head_revision}^" >/dev/null 2>&1; then
    base_revision="$(git rev-parse "${head_revision}^")"
  else
    base_revision="$(git rev-list --max-parents=0 "$head_revision")"
  fi
fi

files=()
while IFS= read -r -d '' file; do
  case "$file" in
    lib/EpdFont/builtinFonts/* | lib/Epub/Epub/hyphenation/generated/* | lib/uzlib/*) ;;
    *) files+=("$file") ;;
  esac
done < <(
  git diff --name-only --diff-filter=ACMR -z "$base_revision" "$head_revision" -- \
    '*.c' '*.cpp' '*.h' '*.hpp'
)

if (( ${#files[@]} == 0 )); then
  echo "No changed C/C++ files to check"
  exit 0
fi

printf 'Checking %d changed C/C++ files with %s\n' "${#files[@]}" "$version"
"$CLANG_FORMAT_BIN" --dry-run --Werror -style=file "${files[@]}"
