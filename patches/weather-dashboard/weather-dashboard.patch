+#pragma once
+
+#include "lunar_calendar.h"
+#include "noto_sans_vi_8b.h"
+#include "noto_sans_vi_12b.h"
+#include "weather_state.h"
+
+constexpr int DASHBOARD_CLOCK_X = 690;
+constexpr int DASHBOARD_CLOCK_Y = 28;
+constexpr int DASHBOARD_CLOCK_W = 240;
+constexpr int DASHBOARD_CLOCK_H = 78;
+constexpr int DASHBOARD_FOOTER_X = 28;
+constexpr int DASHBOARD_FOOTER_Y = 486;
+constexpr int DASHBOARD_FOOTER_W = 904;
+constexpr int DASHBOARD_FOOTER_H = 26;
+
+namespace WeatherDashboard {
+
+inline bool stale(time_t now, time_t updated, bool failed) {
+    return failed || now < updated || now - updated >= WeatherState::kRefreshSeconds;
+}
+
+inline String number(float value, int decimals = 0) {
+    if (!std::isfinite(value)) return "--";
+    String result(value, decimals);
+    result.replace(".", ",");
+    return result;
+}
+
+inline String clockText(time_t epoch) {
+    if (epoch <= 0) return "--:--";
+    tm value;
+    localtime_r(&epoch, &value);
+    char output[6];
+    snprintf(output, sizeof(output), "%02d:%02d", value.tm_hour, value.tm_min);
+    return output;
+}
+
+inline int textWidth(const String &text) {
+    int x = 0, y = 0, x1, y1, width, height;
+    get_text_bounds(&currentFont, text.c_str(), &x, &y, &x1, &y1, &width, &height, nullptr);
+    return width;
+}
+
+inline void text(int x, int y, const String &value, int width, alignment align = LEFT) {
+    String fitted = value;
+    if (textWidth(fitted) > width) {
+        while (fitted.length() && textWidth(fitted + "...") > width) {
+            unsigned end = fitted.length() - 1;
+            while (end && (static_cast<unsigned char>(fitted[end]) & 0xC0) == 0x80) --end;
+            fitted = fitted.substring(0, end);
+        }
+        fitted += "...";
+    }
+    drawString(x, y, fitted, align);
+}
+
+inline const char *description(int code, const String &icon) {
+    if (code >= 200 && code < 300) return "Giông kèm mưa";
+    if (code >= 300 && code < 400) return "Mưa phùn";
+    if (code == 500) return "Mưa nhẹ";
+    if (code == 501) return "Mưa vừa";
+    if (code >= 502 && code <= 504) return "Mưa lớn";
+    if (code == 511) return "Mưa đóng băng";
+    if (code >= 520 && code < 600) return "Mưa rào";
+    if (code >= 600 && code < 700) return "Tuyết rơi";
+    if (code == 701 || code == 741) return "Sương mù";
+    if (code == 711) return "Khói";
+    if (code == 721) return "Mù nhẹ";
+    if (code == 731 || code == 751 || code == 761) return "Bụi trong không khí";
+    if (code == 762) return "Tro núi lửa";
+    if (code == 771) return "Gió giật";
+    if (code == 781) return "Lốc xoáy";
+    if (code == 800) return icon.endsWith("n") ? "Trời quang" : "Trời nắng";
+    if (code == 801) return "Ít mây";
+    if (code == 802) return "Mây rải rác";
+    if (code == 803) return "Nhiều mây";
+    if (code == 804) return "Mây bao phủ";
+    return "Chưa rõ thời tiết";
+}
+
+inline String lunarYearName(int year) {
+    static const char *stems[] = {"Giáp", "Ất", "Bính", "Đinh", "Mậu", "Kỷ", "Canh", "Tân", "Nhâm", "Quý"};
+    static const char *branches[] = {"Tý", "Sửu", "Dần", "Mão", "Thìn", "Tỵ", "Ngọ", "Mùi", "Thân", "Dậu", "Tuất", "Hợi"};
+    return String(stems[(year + 6) % 10]) + " " + branches[(year + 8) % 12];
+}
+
+inline void weatherIcon(int x, int y, const String &icon) {
+    // The vendor's 04 icon draws a sun; overcast conditions need clouds only.
+    if (icon.startsWith("04")) Cloudy(x, y, SmallIcon, icon);
+    else DisplayConditionsSection(x, y, icon, SmallIcon);
+}
+
+inline void calendar(const tm &local) {
+    const int month = local.tm_mon + 1;
+    const int year = local.tm_year + 1900;
+    setFont(NotoSansVi10B);
+    drawString(28, 279, "Tháng " + String(month) + " / " + String(year), LEFT);
+    static const char *weekdays[] = {"T2", "T3", "T4", "T5", "T6", "T7", "CN"};
+    setFont(NotoSansVi8B);
+    for (int col = 0; col < 7; ++col) drawString(54 + col * 56, 312, weekdays[col], CENTER);
+    if (year < 1900 || year > 2099) return;
+    const int firstWeekday = (local.tm_wday - (local.tm_mday - 1) % 7 + 7 + 6) % 7;
+    const int days = VietnameseLunar::detail::daysInMonth(month, year);
+    for (int day = 1; day <= days; ++day) {
+        const int cell = firstWeekday + day - 1;
+        const int x = 54 + (cell % 7) * 56;
+        const int y = 340 + (cell / 7) * 23;
+        setFont(day == local.tm_mday ? NotoSansVi10B : NotoSansVi8B);
+        if (day == local.tm_mday) drawRect(x - 19, y - 3, 39, 24, Black);
+        drawString(x, y - (day == local.tm_mday ? 2 : 0), String(day), CENTER);
+        const auto lunar = VietnameseLunar::fromSolar(day, month, year);
+        if (lunar.valid && (lunar.day == 1 || lunar.day == 15)) {
+            drawFastHLine(x - 8, y + 19, 17, Black);
+            drawFastHLine(x - 8, y + 20, 17, Black);
+        }
+    }
+}
+
+inline void forecast(time_t now, bool available) {
+    setFont(NotoSansVi10B);
+    drawString(480, 279, "Dự báo theo giờ", LEFT);
+    int indices[4] = {-1, -1, -1, -1};
+    int count = 0;
+    if (available) {
+        for (int index = 0; index < max_readings && count < 4; ++index) {
+            if (WxForecast[index].Dt > now) indices[count++] = index;
+        }
+    }
+    if (!count) {
+        setFont(NotoSansVi10B);
+        drawString(480, 343, available ? "Dự báo đã hết hạn" : "Chưa có dự báo", LEFT);
+        setFont(NotoSansVi8B);
+        drawString(480, 377, "Chờ lần cập nhật tiếp theo", LEFT);
+        return;
+    }
+    for (int slot = 0; slot < count; ++slot) {
+        const auto &forecast = WxForecast[indices[slot]];
+        const int x = 528 + slot * 116;
+        time_t epoch = forecast.Dt;
+        tm forecastLocal;
+        localtime_r(&epoch, &forecastLocal);
+        char day[8];
+        snprintf(day, sizeof(day), "%02d/%02d", forecastLocal.tm_mday, forecastLocal.tm_mon + 1);
+        setFont(NotoSansVi8B);
+        drawString(x, 313, day, CENTER);
+        setFont(NotoSansVi10B);
+        drawString(x, 335, clockText(epoch), CENTER);
+        weatherIcon(x, 392, forecast.Icon);
+        setFont(NotoSansVi12B);
+        drawString(x, 430, number(forecast.Temperature) + "°", CENTER);
+        setFont(NotoSansVi8B);
+        const String chance = std::isfinite(forecast.Pop) && forecast.Pop >= 0
+                                  ? number(constrain(forecast.Pop, 0.0f, 1.0f) * 100) + "%"
+                                  : "--";
+        drawString(x, 460, "Mưa " + chance, CENTER);
+    }
+}
+
+inline void footer(time_t now, time_t updated, bool available, bool failed, bool rtcValid) {
+    fillRect(DASHBOARD_FOOTER_X, DASHBOARD_FOOTER_Y, DASHBOARD_FOOTER_W, DASHBOARD_FOOTER_H, White);
+    drawFastHLine(28, 486, 904, LightGrey);
+    setFont(NotoSansVi8B);
+    String status;
+    if (!available || updated <= 0) {
+        status = "Chưa nhận được thời tiết";
+    } else {
+        tm updateLocal, nowLocal;
+        localtime_r(&updated, &updateLocal);
+        localtime_r(&now, &nowLocal);
+        status = "Cập nhật " + clockText(updated);
+        if (updateLocal.tm_yday != nowLocal.tm_yday || updateLocal.tm_year != nowLocal.tm_year) {
+            status += " " + String(updateLocal.tm_mday) + "/" + String(updateLocal.tm_mon + 1);
+        }
+        if (stale(now, updated, failed)) status += " · Dữ liệu cũ";
+    }
+    if (!rtcValid) status += " · RTC chưa sẵn sàng";
+    text(28, 489, status, 720);
+    String battery = dashboardBatteryPercent >= 0 ? "Pin " + String(constrain(dashboardBatteryPercent, 0, 100)) + "%" : "Pin --";
+    drawString(931, 489, battery, RIGHT);
+}
+
+}  // namespace WeatherDashboard
+
+inline void DisplayDashboardClock(const tm &local) {
+    fillRect(DASHBOARD_CLOCK_X, DASHBOARD_CLOCK_Y, DASHBOARD_CLOCK_W, DASHBOARD_CLOCK_H, White);
+    char clock[6];
+    snprintf(clock, sizeof(clock), "%02d:%02d", local.tm_hour, local.tm_min);
+    setFont(OpenSans24B);
+    drawString(810, 31, local.tm_year >= 124 ? String(clock) : "--:--", CENTER);
+    setFont(NotoSansVi8B);
+    drawString(810, 87, "Giờ Việt Nam", CENTER);
+}
+
+inline void DisplayDashboard(const tm &local, time_t now, time_t lastWeatherUpdate,
+                             bool weatherAvailable, bool lastFetchFailed, bool rtcValid) {
+    using namespace WeatherDashboard;
+    setFont(NotoSansVi12B);
+    const String location = City == "Ho Chi Minh City" || City == "Ho Chi Minh" ? "TP. Hồ Chí Minh" : City;
+    text(28, 31, location, 620);
+    static const char *weekdays[] = {"Chủ nhật", "Thứ hai", "Thứ ba", "Thứ tư", "Thứ năm", "Thứ sáu", "Thứ bảy"};
+    char date[16];
+    snprintf(date, sizeof(date), "%02d/%02d/%04d", local.tm_mday, local.tm_mon + 1, local.tm_year + 1900);
+    setFont(NotoSansVi10B);
+    text(28, 75, String(weekdays[constrain(local.tm_wday, 0, 6)]) + ", " + date, 620);
+    DisplayDashboardClock(local);
+    drawFastHLine(28, 113, 904, Black);
+
+    const auto &weather = WxConditions[0];
+    if (weatherAvailable) {
+        setFont(OpenSans24B);
+        drawString(28, 132, number(weather.Temperature, 1) + "°C", LEFT);
+        weatherIcon(308, 164, weather.Icon);
+        setFont(NotoSansVi12B);
+        text(28, 198, description(weather.ConditionCode, weather.Icon), 340);
+        setFont(NotoSansVi8B);
+        drawString(396, 136, "Cảm giác như", LEFT);
+        drawString(595, 136, "Độ ẩm", LEFT);
+        drawString(795, 136, "Gió", LEFT);
+        setFont(NotoSansVi12B);
+        drawString(396, 164, number(weather.Feelslike, 1) + "°C", LEFT);
+        drawString(595, 164, number(weather.Humidity) + "%", LEFT);
+        drawString(795, 164, number(weather.Windspeed, 1) + " m/s", LEFT);
+        setFont(NotoSansVi8B);
+        drawString(396, 211, "Mặt trời mọc " + clockText(weather.Sunrise), LEFT);
+        drawString(688, 211, "Mặt trời lặn " + clockText(weather.Sunset), LEFT);
+    } else {
+        setFont(NotoSansVi12B);
+        drawString(28, 148, "Chưa có dữ liệu thời tiết", LEFT);
+        setFont(NotoSansVi10B);
+        drawString(28, 194, "Lịch và đồng hồ vẫn hoạt động", LEFT);
+    }
+    const auto lunar = VietnameseLunar::fromSolar(local.tm_mday, local.tm_mon + 1, local.tm_year + 1900);
+    setFont(NotoSansVi10B);
+    if (lunar.valid) {
+        String lunarText = "Âm lịch " + String(lunar.day) + "/" + String(lunar.month);
+        if (lunar.leap) lunarText += " nhuận";
+        lunarText += " · Năm " + lunarYearName(lunar.year);
+        if (lunar.day == 1) lunarText += " · Mùng một";
+        if (lunar.day == 15) lunarText += " · Ngày rằm";
+        text(28, 236, lunarText, 904);
+    }
+    drawFastHLine(28, 267, 904, Black);
+    calendar(local);
+    drawFastVLine(448, 283, 189, LightGrey);
+    forecast(now, weatherAvailable);
+    footer(now, lastWeatherUpdate, weatherAvailable, lastFetchFailed, rtcValid);
+}
diff --git a/weather_rtc.h b/weather_rtc.h
new file mode 100644
index 0000000..d98675b
--- /dev/null
+++ b/weather_rtc.h
@@ -0,0 +1,105 @@
+#pragma once
+
+#include <Wire.h>
+#include <stdint.h>
+#include <time.h>
+
+// PCF8563 on LilyGo T5-4.7-S3 V2.4. Calendar registers always contain UTC;
+// localtime_r() applies the configured timezone only when drawing the screen.
+class WeatherRtc {
+ public:
+  explicit WeatherRtc(TwoWire& wire = Wire) : wire_(wire) {}
+
+  bool begin() {
+    if (!wire_.begin(18, 17, 100000)) return false;
+    wire_.setTimeOut(50);
+    uint8_t status;
+    ready_ = readRegisters(0x00, &status, 1);
+    return ready_;
+  }
+
+  bool readUtc(time_t& utc) {
+    uint8_t registers[9];
+    if (!ready_ || !readRegisters(0x00, registers, sizeof(registers))) return false;
+    // STOP/test clock mode, voltage-low or the unsupported 1900s century.
+    if ((registers[0] & 0xa0) || (registers[2] & 0x80) || (registers[7] & 0x80)) return false;
+
+    uint8_t second, minute, hour, day, month, year;
+    if (!decodeBcd(registers[2] & 0x7f, 0, 59, second) || !decodeBcd(registers[3] & 0x7f, 0, 59, minute) ||
+        !decodeBcd(registers[4] & 0x3f, 0, 23, hour) || !decodeBcd(registers[5] & 0x3f, 1, 31, day) ||
+        !decodeBcd(registers[7] & 0x1f, 1, 12, month) || !decodeBcd(registers[8], 0, 99, year) ||
+        (registers[6] & 0x07) > 6)
+      return false;
+
+    const int fullYear = 2000 + year;
+    if (day > monthDays(fullYear, month)) return false;
+    int64_t days = 10957;  // 1970-01-01 to 2000-01-01.
+    for (int y = 2000; y < fullYear; ++y) days += leapYear(y) ? 366 : 365;
+    for (int m = 1; m < month; ++m) days += monthDays(fullYear, m);
+    days += day - 1;
+    const int64_t epoch = days * 86400 + hour * 3600 + minute * 60 + second;
+    const time_t candidate = static_cast<time_t>(epoch);
+    if (static_cast<int64_t>(candidate) != epoch) return false;
+    utc = candidate;
+    return true;
+  }
+
+  bool writeUtc(time_t utc) {
+    if (!ready_) return false;
+    struct tm date;
+    if (gmtime_r(&utc, &date) == nullptr || date.tm_year < 100 || date.tm_year > 199) return false;
+
+    uint8_t status;
+    if (!readRegisters(0x00, &status, 1)) return false;
+    // A single transfer latches all calendar counters; never write alarm,
+    // timer, interrupt or CLKOUT registers shared with another firmware.
+    wire_.beginTransmission(kAddress);
+    wire_.write(0x02);
+    wire_.write(encodeBcd(date.tm_sec));  // Valid time clears voltage-low.
+    wire_.write(encodeBcd(date.tm_min));
+    wire_.write(encodeBcd(date.tm_hour));
+    wire_.write(encodeBcd(date.tm_mday));
+    wire_.write(static_cast<uint8_t>(date.tm_wday));
+    wire_.write(encodeBcd(date.tm_mon + 1));
+    wire_.write(encodeBcd(date.tm_year - 100));
+    if (wire_.endTransmission() != 0) return false;
+
+    // The reserved bits must be zero when writing Control_status_1.
+    if (status & 0xa8) {
+      wire_.beginTransmission(kAddress);
+      wire_.write(static_cast<uint8_t>(0x00));
+      wire_.write(static_cast<uint8_t>(0x00));
+      if (wire_.endTransmission() != 0) return false;
+    }
+    return true;
+  }
+
+ private:
+  static constexpr uint8_t kAddress = 0x51;
+  TwoWire& wire_;
+  bool ready_ = false;
+
+  static bool leapYear(int year) { return year % 4 == 0 && (year % 100 != 0 || year % 400 == 0); }
+
+  static int monthDays(int year, int month) {
+    static const uint8_t lengths[] = {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
+    return lengths[month - 1] + (month == 2 && leapYear(year) ? 1 : 0);
+  }
+
+  static bool decodeBcd(uint8_t raw, uint8_t minimum, uint8_t maximum, uint8_t& value) {
+    if ((raw & 0x0f) > 9 || (raw >> 4) > 9) return false;
+    value = (raw >> 4) * 10 + (raw & 0x0f);
+    return value >= minimum && value <= maximum;
+  }
+
+  static uint8_t encodeBcd(int value) { return static_cast<uint8_t>((value / 10) << 4 | (value % 10)); }
+
+  bool readRegisters(uint8_t first, uint8_t* destination, uint8_t length) {
+    wire_.beginTransmission(kAddress);
+    wire_.write(first);
+    if (wire_.endTransmission(false) != 0) return false;
+    if (wire_.requestFrom(kAddress, length, static_cast<uint8_t>(true)) != length) return false;
+    for (uint8_t i = 0; i < length; ++i) destination[i] = wire_.read();
+    return true;
+  }
+};
diff --git a/weather_runtime.h b/weather_runtime.h
new file mode 100644
index 0000000..69bc75b
--- /dev/null
+++ b/weather_runtime.h
@@ -0,0 +1,365 @@
+#pragma once
+
+#include <sys/time.h>
+#include <memory>
+#include <new>
+#include <errno.h>
+#include <esp_sntp.h>
+#include <driver/rtc_io.h>
+#include "weather_state.h"
+#include "weather_rtc.h"
+
+void InitialiseSystem();
+void ShowSetupScreen(const String &reason);
+uint8_t StartWiFi();
+void StopWiFi();
+bool obtainWeatherData(WiFiClient &client, const String &type);
+bool RenderDashboard(bool full, bool clockValid, bool rtcValid, time_t now);
+
+constexpr int WEATHER_BUTTON = 21;
+constexpr uint32_t DISPLAY_STATE_VERSION = 0x44534803;
+RTC_DATA_ATTR WeatherState::Cache weatherCache = {};
+RTC_DATA_ATTR uint32_t displayStateVersion = 0;
+RTC_DATA_ATTR int64_t lastFullRefresh = 0;
+RTC_DATA_ATTR int lastDisplayDay = 0;
+RTC_DATA_ATTR int64_t lastForecastSlot = 0;
+RTC_DATA_ATTR bool lastDisplayFailed = false;
+RTC_DATA_ATTR bool lastDisplayStale = false;
+RTC_DATA_ATTR bool lastDisplayRtc = false;
+WeatherRtc weatherRtc;
+volatile bool ntpSynchronized = false;
+
+inline bool ClockValid(time_t value) {
+    return WeatherState::validEpoch(static_cast<int64_t>(value));
+}
+
+inline uint32_t LocationHash() {
+    uint32_t result = 2166136261U;
+    const String identity = City + "|" + Country + "|M|ICT-7";
+    for (unsigned i = 0; i < identity.length(); ++i)
+        result = (result ^ static_cast<uint8_t>(identity[i])) * 16777619U;
+    return result;
+}
+
+inline WeatherState::Reading PackReading(const Forecast_record_type &from) {
+    WeatherState::Reading to = {};
+    to.dt = from.Dt;
+    to.sunrise = from.Sunrise;
+    to.sunset = from.Sunset;
+    to.temperature = from.Temperature;
+    to.feelsLike = from.Feelslike;
+    to.high = from.High;
+    to.low = from.Low;
+    to.humidity = from.Humidity;
+    to.pressure = from.Pressure;
+    to.windDirection = from.Winddir;
+    to.windSpeed = from.Windspeed;
+    to.rain = from.Rainfall;
+    to.snow = from.Snowfall;
+    to.pop = from.Pop;
+    to.conditionCode = from.ConditionCode;
+    to.cloudCover = from.Cloudcover;
+    to.visibility = from.Visibility;
+    to.timezone = from.Timezone;
+    if (from.Icon.length() == 3) memcpy(to.icon, from.Icon.c_str(), 3);
+    return to;
+}
+
+inline void UnpackReading(const WeatherState::Reading &from, Forecast_record_type &to) {
+    to.Dt = from.dt;
+    to.Sunrise = from.sunrise;
+    to.Sunset = from.sunset;
+    to.Temperature = from.temperature;
+    to.Feelslike = from.feelsLike;
+    to.High = from.high;
+    to.Low = from.low;
+    to.Humidity = from.humidity;
+    to.Pressure = from.pressure;
+    to.Winddir = from.windDirection;
+    to.Windspeed = from.windSpeed;
+    to.Rainfall = from.rain;
+    to.Snowfall = from.snow;
+    to.Pop = from.pop;
+    to.ConditionCode = from.conditionCode;
+    to.Cloudcover = from.cloudCover;
+    to.Visibility = from.visibility;
+    to.Timezone = from.timezone;
+    to.Icon = from.icon;
+}
+
+inline bool LoadWeatherCache(const char *path, uint32_t location) {
+    File file = SPIFFS.open(path, FILE_READ);
+    if (!file || file.size() != sizeof(weatherCache)) return false;
+    std::unique_ptr<WeatherState::Cache> candidate(new (std::nothrow) WeatherState::Cache{});
+    if (!candidate) return false;
+    const size_t count = file.read(reinterpret_cast<uint8_t *>(candidate.get()), sizeof(*candidate));
+    file.close();
+    if (count != sizeof(*candidate) || !WeatherState::hasWeather(*candidate) || candidate->locationHash != location)
+        return false;
+    weatherCache = *candidate;
+    Serial.printf("Weather cache restored: %s; updated=%ld\n", path, static_cast<long>(weatherCache.lastSuccess));
+    return true;
+}
+
+inline bool CacheSaveFailure(const char *stage) {
+    const int error = errno;
+    Serial.printf("Cache save failed: %s errno=%d used=%u total=%u\n", stage, error,
+                  static_cast<unsigned>(SPIFFS.usedBytes()), static_cast<unsigned>(SPIFFS.totalBytes()));
+    return false;
+}
+
+inline bool SaveWeatherCache() {
+    std::unique_ptr<WeatherState::Cache> persisted(new (std::nothrow) WeatherState::Cache{});
+    if (!persisted) {
+        errno = ENOMEM;
+        return CacheSaveFailure("allocate verification");
+    }
+    errno = 0;
+    File file = SPIFFS.open("/weather.tmp", FILE_WRITE);
+    if (!file) return CacheSaveFailure("open tmp");
+    const size_t written = file.write(reinterpret_cast<const uint8_t *>(&weatherCache), sizeof(weatherCache));
+    const int writeError = errno;
+    file.flush();
+    file.close();
+
+    // SPIFFS can report stale metadata while the writer is open. Verify a fresh
+    // read handle, including the full snapshot, before moving the previous cache.
+    errno = 0;
+    File verification = SPIFFS.open("/weather.tmp", FILE_READ);
+    if (!verification) {
+        CacheSaveFailure("reopen tmp");
+        SPIFFS.remove("/weather.tmp");
+        return false;
+    }
+    const size_t persistedSize = verification.size();
+    errno = 0;
+    const size_t readCount = verification.read(reinterpret_cast<uint8_t *>(persisted.get()), sizeof(*persisted));
+    const int readError = errno;
+    verification.close();
+    const bool complete = written == sizeof(weatherCache) && persistedSize == sizeof(weatherCache) &&
+                          readCount == sizeof(weatherCache);
+    const bool matches = complete && WeatherState::hasWeather(*persisted) &&
+                         memcmp(persisted.get(), &weatherCache, sizeof(weatherCache)) == 0;
+    if (!matches) {
+        Serial.printf("Cache tmp read-back: wrote=%u size=%u read=%u expected=%u\n",
+                      static_cast<unsigned>(written), static_cast<unsigned>(persistedSize),
+                      static_cast<unsigned>(readCount), static_cast<unsigned>(sizeof(weatherCache)));
+        errno = readError ? readError : writeError ? writeError : EIO;
+        CacheSaveFailure(complete ? "validate tmp" : "read back tmp");
+        SPIFFS.remove("/weather.tmp");
+        return false;
+    }
+    persisted.reset();
+    const bool hadCache = SPIFFS.exists("/weather.bin");
+    if (hadCache) {
+        errno = 0;
+        if (SPIFFS.exists("/weather.bak") && !SPIFFS.remove("/weather.bak"))
+            return CacheSaveFailure("remove old bak");
+        errno = 0;
+        if (!SPIFFS.rename("/weather.bin", "/weather.bak")) return CacheSaveFailure("rename bin to bak");
+    }
+    errno = 0;
+    if (!SPIFFS.rename("/weather.tmp", "/weather.bin")) {
+        CacheSaveFailure("rename tmp to bin");
+        if (hadCache) SPIFFS.rename("/weather.bak", "/weather.bin");
+        return false;
+    }
+    if (SPIFFS.exists("/weather.bak")) SPIFFS.remove("/weather.bak");
+    return true;
+}
+
+inline bool RtcUsesUtc() {
+    File marker = SPIFFS.open("/rtc-utc-v1", FILE_READ);
+    uint32_t value = 0;
+    return marker && marker.read(reinterpret_cast<uint8_t *>(&value), sizeof(value)) == sizeof(value) &&
+           value == 0x55544331U;
+}
+
+inline bool SynchronizeClock() {
+    ntpSynchronized = false;
+    sntp_set_time_sync_notification_cb([](struct timeval *) { ntpSynchronized = true; });
+    configTime(0, 0, ntpServer.c_str(), "time.nist.gov");
+    setenv("TZ", "ICT-7", 1);
+    tzset();
+    const unsigned long started = millis();
+    while (!ntpSynchronized && millis() - started < 8000) delay(50);
+    const time_t now = time(nullptr);
+    if (!ntpSynchronized || !ClockValid(now)) {
+        Serial.println("NTP unavailable; keeping RTC time");
+        return false;
+    }
+    if (!weatherRtc.writeUtc(now)) {
+        Serial.println("NTP synchronized; external RTC write failed");
+        return false;
+    }
+    if (!RtcUsesUtc()) {
+        File marker = SPIFFS.open("/rtc-utc-v1", FILE_WRITE);
+        const uint32_t value = 0x55544331U;
+        if (marker) {
+            marker.write(reinterpret_cast<const uint8_t *>(&value), sizeof(value));
+            marker.close();
+        }
+    }
+    Serial.printf("NTP -> PCF8563 UTC: %ld\n", static_cast<long>(now));
+    return true;
+}
+
+inline void SleepUntilNextMinute() {
+    epd_poweroff_all();
+    struct timeval now;
+    gettimeofday(&now, nullptr);
+    // No valid time means there is no clock to advance. Back off failed first setup.
+    const uint32_t seconds = ClockValid(now.tv_sec) ? WeatherState::secondsUntilNextMinute(now.tv_sec) : 900;
+    const uint64_t sleepUs = static_cast<uint64_t>(seconds) * 1000000ULL - now.tv_usec + 20000ULL;
+    esp_sleep_enable_timer_wakeup(sleepUs);
+    if (digitalRead(WEATHER_BUTTON)) {
+        // S4 / SENSOR_VN has an external 3.3 V pull-up on the V2.4 schematic.
+        rtc_gpio_pullup_en(GPIO_NUM_21);
+        rtc_gpio_pulldown_dis(GPIO_NUM_21);
+        esp_sleep_enable_ext1_wakeup(1ULL << WEATHER_BUTTON, ESP_EXT1_WAKEUP_ALL_LOW);
+    }
+    Serial.printf("Clock sleep: %lu ms; awake: %lu ms; WiFi off\n",
+                  static_cast<unsigned long>(sleepUs / 1000), millis() - StartTime);
+    // HWCDC::flush() in Arduino 2.0.11 can wait forever without a USB reader.
+    // Give diagnostics a bounded grace period; display/sleep never depend on USB.
+    delay(20);
+    esp_deep_sleep_start();
+}
+
+inline void RunWeatherDashboard() {
+    InitialiseSystem();
+    const bool filesystemReady = SPIFFS.begin();
+    if (filesystemReady && !SPIFFS.exists("/config.json") && SPIFFS.exists("/config.bak"))
+        SPIFFS.rename("/config.bak", "/config.json");
+    rtc_gpio_deinit(GPIO_NUM_21);
+    pinMode(WEATHER_BUTTON, INPUT_PULLUP);
+    const unsigned long pressedAt = millis();
+    while (!digitalRead(WEATHER_BUTTON) && millis() - pressedAt < 1200) delay(10);
+    const bool setupRequested = !digitalRead(WEATHER_BUTTON);
+    if (!filesystemReady || !SPIFFS.exists("/config.json") || setupRequested) {
+        ShowSetupScreen(filesystemReady ? "Cài đặt kết nối và thời tiết" : "Không đọc được bộ nhớ cài đặt");
+        return;
+    }
+    DynamicJsonDocument config(2048);
+    File file = SPIFFS.open("/config.json", FILE_READ);
+    const auto error = deserializeJson(config, file);
+    file.close();
+    if (error) { ShowSetupScreen("Không đọc được cấu hình đã lưu"); return; }
+    ssid = config["WLAN"]["ssid"].as<String>();
+    password = config["WLAN"]["password"].as<String>();
+    apikey = config["OpenWeather"]["apikey"].as<String>();
+    server = config["OpenWeather"]["server"] | "api.openweathermap.org";
+    City = config["OpenWeather"]["city"] | "Ho Chi Minh";
+    Country = config["OpenWeather"]["country"] | "VN";
+    Hemisphere = "north";
+    Units = "M";
+    Timezone = "ICT-7";
+    ntpServer = config["ntp"]["server"] | "0.asia.pool.ntp.org";
+    if (City.isEmpty()) City = "Ho Chi Minh";
+    if (Country.isEmpty()) Country = "VN";
+    if (server.isEmpty()) server = "api.openweathermap.org";
+    if (ntpServer.isEmpty()) ntpServer = "0.asia.pool.ntp.org";
+    if (ssid.isEmpty() || ssid.startsWith("Your ") || apikey.isEmpty() || apikey.startsWith("Your ")) {
+        ShowSetupScreen("Cần lưu Wi-Fi và khóa OpenWeather");
+        return;
+    }
+    setenv("TZ", "ICT-7", 1);
+    tzset();
+    time_t rtcEpoch = 0;
+    const bool rtcOnline = weatherRtc.begin();
+    bool rtcValid = rtcOnline && RtcUsesUtc() && weatherRtc.readUtc(rtcEpoch) && ClockValid(rtcEpoch);
+    if (rtcValid) {
+        const struct timeval rtcTime = {rtcEpoch, 0};
+        settimeofday(&rtcTime, nullptr);
+        Serial.printf("PCF8563 UTC restored: %ld\n", static_cast<long>(rtcEpoch));
+    } else {
+        Serial.printf("RTC online=%d; awaiting validated UTC sync\n", rtcOnline);
+    }
+    const uint32_t location = LocationHash();
+    if (!WeatherState::valid(weatherCache) || weatherCache.locationHash != location) {
+        if (!LoadWeatherCache("/weather.bin", location) && !LoadWeatherCache("/weather.bak", location)) {
+            WeatherState::clear(weatherCache);
+            weatherCache.locationHash = location;
+            WeatherState::seal(weatherCache);
+        }
+        weatherDisplayed = false;
+    }
+    time_t now = time(nullptr);
+    const auto wakeup = esp_sleep_get_wakeup_cause();
+    const bool manual = wakeup != ESP_SLEEP_WAKEUP_TIMER;
+    const bool fetch = WeatherState::shouldFetch(weatherCache, now, manual);
+    bool updated = false;
+    if (fetch) {
+        Serial.println("Weather refresh due");
+        bool currentOk = false, forecastOk = false;
+        if (StartWiFi() == WL_CONNECTED) {
+            if (SynchronizeClock()) rtcValid = true;
+            WiFiClient client;
+            for (int attempt = 0; attempt < 2 && (!currentOk || !forecastOk); ++attempt) {
+                if (!currentOk) currentOk = obtainWeatherData(client, "weather");
+                if (!forecastOk) forecastOk = obtainWeatherData(client, "forecast");
+            }
+        }
+        StopWiFi();
+        now = time(nullptr);
+        if (currentOk && forecastOk && ClockValid(now)) {
+            std::unique_ptr<WeatherState::Cache> candidate(new (std::nothrow) WeatherState::Cache{});
+            if (candidate) {
+                WeatherState::clear(*candidate);
+                candidate->locationHash = location;
+                candidate->lastSuccess = candidate->lastAttempt = now;
+                candidate->forecastCount = max_readings;
+                candidate->current = PackReading(WxConditions[0]);
+                for (int i = 0; i < max_readings; ++i) candidate->forecast[i] = PackReading(WxForecast[i]);
+                WeatherState::seal(*candidate);
+                if (WeatherState::hasWeather(*candidate)) {
+                    weatherCache = *candidate;
+                    updated = true;
+                    Serial.printf("Weather cache committed; disk=%d\n", SaveWeatherCache());
+                } else Serial.println("Rejected invalid weather snapshot; previous cache kept");
+            } else Serial.println("Cache allocation failed; previous cache kept");
+        }
+        if (!updated && ClockValid(now)) {
+            weatherCache.lastAttempt = now;
+            WeatherState::seal(weatherCache);
+            Serial.println("Weather refresh failed; cached display, retry in 15 minutes");
+        }
+    } else {
+        Serial.println("Minute tick: cached weather, WiFi stays off");
+    }
+    const bool available = WeatherState::hasWeather(weatherCache);
+    if (available) {
+        UnpackReading(weatherCache.current, WxConditions[0]);
+        for (int i = 0; i < max_readings; ++i) UnpackReading(weatherCache.forecast[i], WxForecast[i]);
+    }
+    for (int pass = 0; pass < 2; ++pass) {
+        now = time(nullptr);
+        const bool clockValid = ClockValid(now);
+        struct tm local = {};
+        if (clockValid) localtime_r(&now, &local);
+        const int day = (local.tm_year + 1900) * 10000 + (local.tm_mon + 1) * 100 + local.tm_mday;
+        const bool failed = weatherCache.lastAttempt > weatherCache.lastSuccess;
+        const bool stale = WeatherState::isStale(weatherCache, now);
+        const int64_t forecastSlot = static_cast<int64_t>(now) / 10800;
+        const bool full = !weatherDisplayed || displayStateVersion != DISPLAY_STATE_VERSION || !clockValid || updated ||
+            day != lastDisplayDay || now < lastFullRefresh || now - lastFullRefresh >= 3600 ||
+            forecastSlot != lastForecastSlot || failed != lastDisplayFailed || stale != lastDisplayStale ||
+            rtcValid != lastDisplayRtc;
+        weatherDisplayed = RenderDashboard(full, clockValid, rtcValid, now);
+        if (!weatherDisplayed) break;
+        if (full) {
+            lastFullRefresh = now;
+            lastDisplayDay = day;
+            lastForecastSlot = forecastSlot;
+            lastDisplayFailed = failed;
+            lastDisplayStale = stale;
+            lastDisplayRtc = rtcValid;
+            displayStateVersion = DISPLAY_STATE_VERSION;
+        }
+        updated = false;
+        // A slow full refresh can cross midnight or a minute boundary.
+        if (!clockValid || time(nullptr) / 60 == now / 60) break;
+    }
+    Serial.printf("Loop stack minimum free: %u bytes\n", static_cast<unsigned>(uxTaskGetStackHighWaterMark(nullptr)));
+    SleepUntilNextMinute();
+}
