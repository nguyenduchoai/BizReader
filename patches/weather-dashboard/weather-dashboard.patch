+#!/usr/bin/env python3
+"""Exercise margin checks for every OpenWeather icon, day and night."""
+from pathlib import Path
+import os
+import subprocess
+import sys
+
+here = Path(__file__).resolve().parent
+descriptions = {
+    '01': 'clear sky', '02': 'few clouds', '03': 'scattered clouds',
+    '04': 'overcast clouds', '09': 'shower rain and drizzle',
+    '10': 'light intensity drizzle rain', '11': 'thunderstorm with heavy drizzle',
+    '13': 'heavy shower snow', '50': 'sand dust whirls',
+}
+failed = []
+for code, description in descriptions.items():
+    for period in ('d', 'n'):
+        icon = code + period
+        env = dict(os.environ, PREVIEW_ICON=icon, PREVIEW_DESCRIPTION=description)
+        result = subprocess.run([str(here / 'weather-preview'), str(here / f'case-{icon}.pgm')],
+                                env=env, capture_output=True, text=True)
