diff --git a/scripts/generate_vi_font.py b/scripts/generate_vi_font.py
new file mode 100644
index 0000000..007d7cb
--- /dev/null
+++ b/scripts/generate_vi_font.py
@@ -0,0 +1,157 @@
+#!/usr/bin/env python3
+"""Generate the weather UI's Vietnamese GFXfont using freetype-py.
+
+The 4bpp nibble order, per-glyph zlib streams and font structures match
+LilyGo-EPD47/scripts/fontconvert.py. Requires freetype-py; Pillow is only
+needed for the optional decoded-bitmap preview.
+"""
+
+import argparse
+import math
+from pathlib import Path
+import sys
+import unicodedata
+import zlib
+
+import freetype
+
+
+INTERVALS = (
+    (0x0020, 0x007E),
+    (0x00A0, 0x00FF),
+    (0x0102, 0x0103),
+    (0x0110, 0x0111),
+    (0x0128, 0x0129),
+    (0x0168, 0x0169),
+    (0x01A0, 0x01A1),
+    (0x01AF, 0x01B0),
+    (0x1EA0, 0x1EF9),
+)
+SAMPLE_LINES = (
+    "\u00c2m l\u1ecbch: 24/08/2026 | N\u0103m B\u00ednh Ng\u1ecd",
+    "Ch\u1ee7 nh\u1eadt | Th\u00e0nh ph\u1ed1 H\u1ed3 Ch\u00ed Minh",
+    "Th\u1ee9 hai | Th\u1ee9 ba | Th\u1ee9 t\u01b0 | Th\u1ee9 n\u0103m | Th\u1ee9 s\u00e1u | Th\u1ee9 b\u1ea3y",
+)
+
+
+def make_glyph(face, codepoint, offset):
+    index = face.get_char_index(codepoint)
+    if not index:
+        raise ValueError(f"Font is missing U+{codepoint:04X}")
+    face.load_glyph(index, freetype.FT_LOAD_RENDER)
+    bitmap = face.glyph.bitmap
+    if bitmap.width and bitmap.pixel_mode != freetype.FT_PIXEL_MODE_GRAY:
+        raise ValueError("Only grayscale FreeType bitmaps are supported")
+    pixels = bytearray()
+    for y in range(bitmap.rows):
+        row = y if bitmap.pitch >= 0 else bitmap.rows - y - 1
+        base = row * abs(bitmap.pitch)
+        for x in range(0, bitmap.width, 2):
+            value = bitmap.buffer[base + x] >> 4
+            if x + 1 < bitmap.width:
+                value |= bitmap.buffer[base + x + 1] & 0xF0
+            pixels.append(value)
+    packed = zlib.compress(bytes(pixels))
+    assert zlib.decompress(packed) == pixels
+    props = (
+        bitmap.width, bitmap.rows, math.floor(face.glyph.advance.x / 64),
+        face.glyph.bitmap_left, face.glyph.bitmap_top, len(packed), offset,
+    )
+    assert all(0 <= value <= 255 for value in props[:3])
+    assert props[5] <= 65535
+    return props, packed, len(pixels)
+
+
+def text_width(text, glyphs):
+    normalized = unicodedata.normalize("NFC", text)
+    missing = [f"U+{ord(char):04X}" for char in normalized if ord(char) not in glyphs]
+    if missing:
+        raise ValueError("Sample text contains unsupported codepoints: " + ", ".join(missing))
+    return sum(glyphs[ord(char)][0][2] for char in normalized)
+
+
+def preview(path, glyphs, line_height, ascender):
+    from PIL import Image
+
+    margin = 16
+    width = max(text_width(line, glyphs) for line in SAMPLE_LINES) + margin * 2
+    canvas = Image.new("L", (width, margin * 2 + len(SAMPLE_LINES) * line_height), 255)
+    for line_index, text in enumerate(SAMPLE_LINES):
+        x = margin
+        baseline = margin + ascender + line_index * line_height
+        for char in unicodedata.normalize("NFC", text):
+            props, compressed, _ = glyphs[ord(char)]
+            glyph_width, glyph_height, advance, left, top, _, _ = props
+            data = zlib.decompress(compressed)
+            stride = (glyph_width + 1) // 2
+            for gy in range(glyph_height):
+                for gx in range(glyph_width):
+                    pixel = data[gy * stride + gx // 2]
+                    alpha = ((pixel >> (4 * (gx % 2))) & 15) * 17
+                    cx, cy = x + left + gx, baseline - top + gy
+                    canvas.putpixel((cx, cy), min(canvas.getpixel((cx, cy)), 255 - alpha))
+            x += advance
+    canvas.save(path)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--font", type=Path, default=Path(__file__).resolve().parents[3]
+                        / "lib/EpdFont/builtinFonts/source/NotoSans/NotoSans-Bold.ttf")
+    parser.add_argument("--size", type=int, default=10)
+    parser.add_argument("--name", default="NotoSansVi10B")
+    parser.add_argument("--preview", type=Path)
+    args = parser.parse_args()
+
+    face = freetype.Face(str(args.font))
+    face.set_char_size(args.size << 6, args.size << 6, 150, 150)
+    glyphs, offset, unpacked = {}, 0, 0
+    for first, last in INTERVALS:
+        for codepoint in range(first, last + 1):
+            glyph = make_glyph(face, codepoint, offset)
+            glyphs[codepoint] = glyph
+            offset += len(glyph[1])
+            unpacked += glyph[2]
+    line_height = math.ceil(face.size.height / 64)
+    ascender = math.ceil(face.size.ascender / 64)
+    descender = math.floor(face.size.descender / 64)
+
+    print("// Generated by scripts/generate_vi_font.py; do not edit by hand.")
+    print("// Noto Sans Bold: Copyright 2022 The Noto Project Authors.")
+    print("// Font data licensed under SIL OFL 1.1; see NOTO_FONT_LICENSE.txt.")
+    print('#pragma once\n#include "epd_driver.h"')
+    print(f"const uint8_t {args.name}Bitmaps[{offset}] = {{")
+    data = b"".join(glyph[1] for glyph in glyphs.values())
+    for start in range(0, len(data), 16):
+        print("    " + " ".join(f"0x{byte:02X}," for byte in data[start:start + 16]))
+    print("};")
+    print(f"const GFXglyph {args.name}Glyphs[] = {{")
+    for codepoint, (props, _, _) in glyphs.items():
+        print("    { " + ", ".join(map(str, props)) + f" }}, // U+{codepoint:04X}")
+    print("};")
+    print(f"const UnicodeInterval {args.name}Intervals[] = {{")
+    index = 0
+    for first, last in INTERVALS:
+        print(f"    {{ 0x{first:X}, 0x{last:X}, {index} }},")
+        index += last - first + 1
+    print("};")
+    print(f"const GFXfont {args.name} = {{")
+    print(f"    (uint8_t*){args.name}Bitmaps,")
+    print(f"    (GFXglyph*){args.name}Glyphs,")
+    print(f"    (UnicodeInterval*){args.name}Intervals,")
+    print(f"    {len(INTERVALS)}, 1, {line_height}, {ascender}, {descender},")
+    print("};")
+
+    print(f"glyphs={len(glyphs)} bitmap_bytes={offset} unpacked_bytes={unpacked} "
+          f"line_height={line_height} ascender={ascender} descender={descender}", file=sys.stderr)
+    print(f"max_bitmap_height={max(g[0][1] for g in glyphs.values())} "
+          f"max_top={max(g[0][4] for g in glyphs.values())} "
+          f"max_below_baseline={max(g[0][1] - g[0][4] for g in glyphs.values())}", file=sys.stderr)
+    for line in SAMPLE_LINES:
+        print(f"width={text_width(line, glyphs)} text={line}", file=sys.stderr)
+    if args.preview:
+        preview(args.preview, glyphs, line_height, ascender)
+
+
+if __name__ == "__main__":
+    main()
