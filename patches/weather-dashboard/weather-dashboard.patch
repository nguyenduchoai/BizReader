+            "-fsanitize=address,undefined", "-fno-omit-frame-pointer",
+            "-include", str(fixture), str(generated), "-o", str(executable),
+        ], check=True)
+        subprocess.run([str(executable)], check=True)
+
+
+if __name__ == "__main__":
+    main()
