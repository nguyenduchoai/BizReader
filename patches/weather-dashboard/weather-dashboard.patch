+int main(int argc, char **argv) {
+    if (std::getenv("PREVIEW_EPOCH")) fixtureTime = std::strtoll(std::getenv("PREVIEW_EPOCH"), nullptr, 10);
+    setenv("TZ", "ICT-7", 1);
+    tzset();
+    pixels.fill(255);
+    framebuffer = pixels.data();
+    WxConditions[0].Temperature = 31.7;
+    WxConditions[0].Feelslike = 37.2;
+    WxConditions[0].Humidity = 73;
+    WxConditions[0].Windspeed = 3.1;
+    WxConditions[0].Icon = std::getenv("PREVIEW_ICON") ? std::getenv("PREVIEW_ICON") : "04d";
+    WxConditions[0].ConditionCode = std::getenv("PREVIEW_CONDITION") ? atoi(std::getenv("PREVIEW_CONDITION")) : 804;
+    WxConditions[0].Sunrise = fixtureTime - 21600;
+    WxConditions[0].Sunset = fixtureTime + 21600;
+    const time_t firstForecast = (fixtureTime / 10800 + 1) * 10800;
+    for (int i = 0; i < max_readings; ++i) {
+        WxForecast[i] = WxConditions[0];
+        WxForecast[i].Dt = firstForecast + i * 10800;
+        WxForecast[i].Temperature = 29 + 4 * sin(i * 0.5);
+        WxForecast[i].Pop = (i % 4) * 0.3;
+    }
+    tm local = *localtime(&fixtureTime);
+    const bool available = !std::getenv("PREVIEW_NO_WEATHER");
+    const bool failed = std::getenv("PREVIEW_FAILED");
+    const bool rtcValid = !std::getenv("PREVIEW_NO_RTC");
+    const int age = std::getenv("PREVIEW_AGE") ? atoi(std::getenv("PREVIEW_AGE")) : 600;
+    const time_t updated = std::getenv("PREVIEW_STALE") ? fixtureTime - 48 * 3600 : fixtureTime - age;
+    if (std::getenv("PREVIEW_STALE")) {
+        for (auto &forecast : WxForecast) forecast.Dt -= 5 * 86400;
+    }
+    if (std::getenv("PREVIEW_LONG_CITY")) City = "Thành phố Hồ Chí Minh và khu vực lân cận phía Đông";
+    if (std::getenv("PREVIEW_EXTREME")) {
+        WxConditions[0].Temperature = -40.5;
+        WxConditions[0].Feelslike = -50.0;
+        WxConditions[0].Humidity = 100;
+        WxConditions[0].Windspeed = 99.9;
+        WxConditions[0].ConditionCode = 731;
+        for (auto &forecast : WxForecast) { forecast.Temperature = -40; forecast.Pop = 1; }
+    }
+    if (WeatherDashboard::stale(fixtureTime, fixtureTime - 3599, false) ||
+        !WeatherDashboard::stale(fixtureTime, fixtureTime - 3600, false) ||
+        !WeatherDashboard::stale(fixtureTime, fixtureTime - 3601, false) ||
+        !WeatherDashboard::stale(fixtureTime, fixtureTime + 1, false) ||
+        !WeatherDashboard::stale(fixtureTime, fixtureTime, true)) {
+        std::cerr << "Stale status boundary mismatch\n";
+        return 5;
+    }
+    DisplayDashboard(local, fixtureTime, updated, available, failed, rtcValid);
+    if (std::getenv("PREVIEW_CLOCK_TEST")) {
+        const auto before = pixels;
+        local.tm_min = (local.tm_min + 1) % 60;
+        DisplayDashboardClock(local);
+        size_t changed = 0;
+        for (int y = 0; y < 540; ++y) for (int x = 0; x < 960; ++x) {
+            if (before[y * 960 + x] == pixels[y * 960 + x]) continue;
+            ++changed;
+            if (x < DASHBOARD_CLOCK_X || x >= DASHBOARD_CLOCK_X + DASHBOARD_CLOCK_W ||
+                y < DASHBOARD_CLOCK_Y || y >= DASHBOARD_CLOCK_Y + DASHBOARD_CLOCK_H) {
+                std::cerr << "Clock repaint escaped its region\n";
+                return 3;
+            }
+        }
+        if (!changed) return 4;
+    }
+    size_t bad = 0, total = 0;
+    for (int y = 0; y < 540; ++y) for (int x = 0; x < 960; ++x) if (pixels[y * 960 + x] < 240) {
+        ++total;
+        inkMinX = min(inkMinX, x); inkMinY = min(inkMinY, y);
+        inkMaxX = max(inkMaxX, x); inkMaxY = max(inkMaxY, y);
+        if (x < 28 || x > 931 || y < 28 || y > 511) ++bad;
+    }
+    std::ofstream out(argc > 1 ? argv[1] : "dashboard.pgm", std::ios::binary);
+    out << "P5\n960 540\n255\n";
+    out.write(reinterpret_cast<char *>(pixels.data()), pixels.size());
+    std::cout << "Ink bounds: [" << inkMinX << "," << inkMinY << "]-[" << inkMaxX << "," << inkMaxY << "]\n"
+              << "Outside safe rectangle: " << bad << " ink pixels; " << outsideCalls
+              << " attempted dark pixels; total ink " << total << "\n";
+    return bad || outsideCalls ? 2 : 0;
+}
