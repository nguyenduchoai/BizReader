+
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parent.parent
+source = (ROOT / "LilyGo-EPD-4-7-OWM-Weather-Display.ino").read_text()
+
+
+def function(name):
+    match = re.search(r"^([\w\s:*]+\b" + re.escape(name) + r"\([^;]*?\))\s*\{", source, re.M)
+    if not match:
+        raise ValueError(name)
+    start = match.start()
+    end = source.index("{", start) + 1
+    depth = 1
+    while depth:
+        if source[end] == "{":
+            depth += 1
+        if source[end] == "}":
+            depth -= 1
+        end += 1
+    return source[start:end].strip()
+
+
+names = (
+    "setFont", "drawString", "fillCircle", "drawFastHLine", "drawFastVLine", "drawLine",
+    "drawCircle", "drawRect", "fillRect", "fillTriangle", "drawPixel",
+    "DisplayConditionsSection", "Sunny", "MostlySunny", "Cloudy", "ChanceRain",
+    "Rain", "Tstorms", "Snow", "Haze", "Fog", "Nodata", "addmoon", "addcloud",
+    "addrain", "addsnow", "addtstorm", "addsun", "addfog",
+)
+functions = "\n".join(function(name) for name in names)
+prototypes = "\n".join(
+    match.group(1).strip() + ";"
+    for match in re.finditer(r"^((?:void|bool|boolean|String|double|float|int)\s+\w+\([^;{}]*?\))\s*\{", functions, re.M)
+)
+defines = "\n".join(
+    re.search(r"^#define\s+" + name + r"\s+.*$", source, re.M).group(0)
+    for name in ("White", "LightGrey", "Grey", "DarkGrey", "Black", "Large", "Small", "max_readings")
+)
+fonts = "\n".join('#include "' + name + '"' for name in (
+    "opensans8b.h", "opensans12b.h", "opensans18b.h", "opensans24b.h", "noto_sans_vi_10b.h",
+))
+globals_source = """
+enum alignment { LEFT, RIGHT, CENTER };
+bool LargeIcon = true, SmallIcon = false;
+GFXfont currentFont;
+uint8_t *framebuffer;
+Forecast_record_type WxConditions[1], WxForecast[max_readings];
+String City = "Ho Chi Minh City";
+int wifi_signal = -50, dashboardBatteryPercent = 82;
+"""
+generated = '#include "host.hpp"\n#include "forecast_record.h"\n' + fonts + "\n" + defines + "\n"
+generated += globals_source + prototypes + "\n" + functions
+generated += '\n#include "weather_dashboard.h"\n#include "dashboard_fixture.hpp"\n'
+(HERE / "dashboard-generated.inc").write_text(generated)
+subprocess.run([
+    "clang++", "-x", "c++", "-std=c++17", "-g", "-fsanitize=address,undefined",
+    "-fno-omit-frame-pointer", "-I" + str(HERE), "-I" + str(ROOT),
+    str(HERE / "dashboard-generated.inc"), "-lz", "-o", str(HERE / "dashboard-preview"),
+], check=True)
+subprocess.run([
+    str(HERE / "dashboard-preview"), str(HERE / (sys.argv[1] if len(sys.argv) > 1 else "dashboard.pgm")),
+], check=True)
