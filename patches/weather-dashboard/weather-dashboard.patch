+++ b/tests/monitor_cycles.py
@@ -0,0 +1,168 @@
+#!/usr/bin/env python3
+"""Read USB logs across deep-sleep disconnects without sending device commands.
+
+The POSIX backend never issues DTR/RTS control ioctls and clears HUPCL so closing
+the port does not request a hang-up. It also preserves pending boot messages.
+The OS or device firmware may still react to opening a port independently of
+these settings. Output timestamps are UTC.
+"""
+
+import argparse
+import codecs
+from datetime import datetime, timezone
+import math
+import os
+from pathlib import Path
+import sys
+import termios
+import time
+
+import serial
+from serial.serialposix import Serial as PosixSerial
+
+
+POLL_SECONDS = 0.05
+
+
+class PassiveSerial(PosixSerial):
+    def _update_dtr_state(self):
+        pass
+
+    def _update_rts_state(self):
+        pass
+
+    def _reset_input_buffer(self):
+        # Serial.open() normally discards the early boot log here.
+        pass
+
+    def _reconfigure_port(self, force_update=False):
+        super()._reconfigure_port(force_update=force_update)
+        attributes = termios.tcgetattr(self.fd)
+        if attributes[2] & termios.HUPCL:
+            attributes[2] &= ~termios.HUPCL
+            termios.tcsetattr(self.fd, termios.TCSANOW, attributes)
+
+    def write(self, data):
+        raise serial.SerialException("Passive monitor does not write to the device")
+
+
+class ConsoleLines:
+    def __init__(self, emit):
+        self.emit = emit
+        self.decoder = codecs.getincrementaldecoder("utf-8")(errors="replace")
+        self.pending = ""
+
+    def feed(self, data):
+        self.pending += self.decoder.decode(data).replace("\r", "\n")
+        while "\n" in self.pending:
+            line, self.pending = self.pending.split("\n", 1)
+            if line:
+                self.emit("serial", line)
+        if len(self.pending) >= 16384:
+            self.emit("serial-partial", self.pending)
+            self.pending = ""
+
+    def finish(self):
+        self.pending += self.decoder.decode(b"", final=True)
+        if self.pending:
+            self.emit("serial-partial", self.pending)
+        self.pending = ""
+        self.decoder.reset()
+
+
+def monitor(port, seconds, emit, *, serial_factory=PassiveSerial,
+            port_exists=os.path.exists, now=time.monotonic, sleep=time.sleep):
+    started = now()
+    deadline = started + seconds
+    device = None
+    lines = ConsoleLines(emit)
+    connections = 0
+    byte_count = 0
+    last_error = None
+
+    def disconnect(reason):
+        nonlocal device
+        if device is not None:
+            try:
+                device.close()
+            except (serial.SerialException, OSError) as error:
+                emit("monitor", f"Close failed: {error}")
+            finally:
+                device = None
+                lines.finish()
+            emit("monitor", reason)
+
+    emit("monitor", f"Start: port={port}; duration={seconds:g}s; polling=50ms; read-only")
+    try:
+        while now() < deadline:
+            if not port_exists(port):
+                disconnect("USB disconnected; waiting for the same port")
+                last_error = None
+            elif device is None:
+                candidate = serial_factory(port=None, baudrate=115200, timeout=0,
+                                           write_timeout=0, rtscts=False, dsrdtr=False)
+                try:
+                    candidate.port = port
+                    candidate.open()
+                except (serial.SerialException, OSError) as error:
+                    candidate.close()
+                    message = str(error)
+                    if message != last_error:
+                        emit("monitor", f"Open failed; will retry: {message}")
+                        last_error = message
+                else:
+                    device = candidate
+                    connections += 1
+                    last_error = None
+                    emit("monitor", f"USB connected #{connections}; no DTR/RTS ioctls; HUPCL off")
+
+            if device is not None:
+                try:
+                    data = device.read(min(max(device.in_waiting, 1), 65536))
+                    if data:
+                        byte_count += len(data)
+                        lines.feed(data)
+                except (serial.SerialException, OSError) as error:
+                    disconnect(f"USB read interrupted: {error}; waiting for reconnect")
+
+            remaining = deadline - now()
+            if remaining > 0:
+                sleep(min(POLL_SECONDS, remaining))
+    finally:
+        disconnect("Port closed")
+        emit("monitor", f"Finished: elapsed={now() - started:.2f}s; "
+                        f"connections={connections}; console_bytes={byte_count}")
+    return connections, byte_count
+
+
+def positive_seconds(value):
+    result = float(value)
+    if not math.isfinite(result) or result <= 0:
+        raise argparse.ArgumentTypeError("seconds must be finite and greater than zero")
+    return result
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--port", default="/dev/cu.usbmodem2101")
+    parser.add_argument("--seconds", type=positive_seconds, default=190)
+    parser.add_argument("--log", type=Path, required=True, help="append timestamped console and connection events")
+    args = parser.parse_args()
+    args.log.parent.mkdir(parents=True, exist_ok=True)
+    with args.log.open("a", encoding="utf-8", buffering=1) as log:
+        def emit(kind, text):
+            timestamp = datetime.now(timezone.utc).isoformat(timespec="milliseconds")
+            line = f"{timestamp} [{kind}] {text}"
+            log.write(line + "\n")
+            print(line, flush=True)
+
+        try:
+            _, byte_count = monitor(args.port, args.seconds, emit)
+        except KeyboardInterrupt:
+            emit("monitor", "Interrupted by host")
+            return 130
+    return 0 if byte_count else 2
+
+
+if __name__ == "__main__":
+    sys.exit(main())
