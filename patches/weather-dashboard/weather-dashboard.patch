+#status{min-height:24px;margin:14px 0 0;font-size:14px;overflow-wrap:anywhere}#status[data-error=true]{color:#9f2828}.saved{font-size:12px;color:#506b5c;font-weight:400;margin-left:6px}@media(max-width:360px){main{padding:18px 14px 28px}.row{grid-template-columns:minmax(0,1fr) 76px;gap:10px}.actions button{width:100%}}
+</style></head>
+<body><main>
+<header><h1>Cài đặt thời tiết</h1><p>BizReader · LilyGo T5S3</p></header>
+<form id="settings" action="/config" method="post">
+<fieldset><legend>Kết nối Wi-Fi</legend>
+<label for="ssid">Tên mạng (SSID)</label><input id="ssid" name="ssid" maxlength="32" required autocomplete="off" autocapitalize="none" spellcheck="false">
+<label for="password">Mật khẩu Wi-Fi <span class="saved" id="password-state"></span></label><input id="password" name="password" type="password" maxlength="64" autocomplete="new-password">
+<label class="check"><input id="open_wifi" name="open_wifi" type="checkbox" value="1">Wi-Fi không có mật khẩu</label>
+</fieldset>
+<fieldset><legend>Thời tiết</legend>
+<label for="apikey">Khoá API OpenWeather <span class="saved" id="apikey-state"></span></label><input id="apikey" name="apikey" type="password" maxlength="32" autocomplete="off" autocapitalize="none" spellcheck="false">
+<div class="row"><div><label for="city">Thành phố</label><input id="city" name="city" maxlength="80" required autocomplete="address-level2"></div><div><label for="country">Mã quốc gia</label><input id="country" name="country" minlength="2" maxlength="2" pattern="[A-Za-z]{2}" required autocomplete="country"></div></div>
+</fieldset>
+<fieldset><legend>Ngày và giờ</legend><label for="ntp_server">Máy chủ giờ (NTP)</label><input id="ntp_server" name="ntp_server" maxlength="253" required autocapitalize="none" spellcheck="false">
+<div class="facts"><div><span>Múi giờ</span> Việt Nam (UTC+7)</div><div><span>Đơn vị</span> °C · mm · m/s</div></div>
+</fieldset>
+<div class="actions"><button id="save" type="submit" disabled>Lưu cài đặt</button><button id="restart" type="button" disabled>Khởi động lại</button></div>
+<p id="status" role="status" aria-live="polite">Đang tải cài đặt...</p>
+</form>
+</main><script>
+'use strict';
+const form=document.getElementById('settings');
+const status=document.getElementById('status');
+const save=document.getElementById('save');
+const restart=document.getElementById('restart');
+const openWifi=document.getElementById('open_wifi');
+const password=document.getElementById('password');
+function message(text,error=false){status.textContent=text;status.dataset.error=String(error);}
+function busy(value){save.disabled=value;restart.disabled=value;}
+openWifi.addEventListener('change',()=>{password.disabled=openWifi.checked;});
+async function request(url,options={}){
+  const response=await fetch(url,{cache:'no-store',...options});
+  if(!response.ok)throw new Error(await response.text());
+  return response;
+}
+async function load(){
+  try{
+    const config=await(await request('/config')).json();
+    if(!config.WLAN||!config.OpenWeather||!config.ntp)throw new Error('Cấu hình không hợp lệ. Hãy khởi động lại thiết bị.');
+    for(const[id,value]of[['ssid',config.WLAN.ssid],['city',config.OpenWeather.city],['country',config.OpenWeather.country],['ntp_server',config.ntp.server]])document.getElementById(id).value=typeof value==='string'?value:'';
+    document.getElementById('password-state').textContent=config.WLAN.password_set?'Đã lưu':'';
+    document.getElementById('apikey-state').textContent=config.OpenWeather.apikey_set?'Đã lưu':'';
+    document.getElementById('apikey').required=!config.OpenWeather.apikey_set;
+    password.value='';document.getElementById('apikey').value='';
+    openWifi.checked=!config.WLAN.password_set;password.disabled=openWifi.checked;
+    busy(false);message('');return true;
+  }catch(error){message('Không tải được cài đặt. '+error.message,true);return false;}
+}
+form.addEventListener('submit',async event=>{
+  event.preventDefault();if(!form.reportValidity())return;
+  busy(true);message('Đang lưu...');
+  try{
+    await request('/config',{method:'POST',body:new URLSearchParams(new FormData(form))});
+    if(await load())message('Đã lưu. Khởi động lại để áp dụng cài đặt.');
+  }catch(error){message('Chưa lưu được. '+error.message,true);busy(false);}
+});
+restart.addEventListener('click',async()=>{
+  busy(true);message('Đang khởi động lại...');
+  try{await request('/restart');message('Thiết bị đang khởi động lại.');}
+  catch(error){message('Không khởi động lại được. '+error.message,true);busy(false);}
+});
+load();
+</script></body></html>)SETTINGS";
diff --git a/tests/check_cache_persistence.py b/tests/check_cache_persistence.py
new file mode 100644
index 0000000..0c35992
--- /dev/null
+++ b/tests/check_cache_persistence.py
@@ -0,0 +1,61 @@
+#!/usr/bin/env python3
+"""Run the firmware's actual cache-save function against a fault-injecting host FS."""
+
+import argparse
+import os
+from pathlib import Path
+import re
+import shlex
+import shutil
+import subprocess
+import tempfile
+
+
+SIGNATURE = re.compile(r"inline\s+bool\s+SaveWeatherCache\s*\(\s*\)\s*\{")
+TOKENS = re.compile(r"//[^\n]*|/\*.*?\*/|\"(?:\\.|[^\"\\])*\"|'(?:\\.|[^'\\])*'|[{}]", re.DOTALL)
+
+
+def extract_save_function(source):
+    matches = list(SIGNATURE.finditer(source))
+    if len(matches) != 1:
+        raise ValueError("Expected exactly one SaveWeatherCache() definition in weather_runtime.h")
+    start = matches[0]
+    depth = 0
+    for token in TOKENS.finditer(source, start.end() - 1):
+        if token.group() == "{":
+            depth += 1
+        elif token.group() == "}":
+            depth -= 1
+            if depth == 0:
+                return source[start.start():token.end()] + "\n"
+    raise ValueError("Unterminated SaveWeatherCache() definition")
+
+
+def main():
