@@ -0,0 +1,106 @@
+#include "../lunar_calendar.h"
+
+#include <cassert>
+#include <cstdio>
+#include <cstdlib>
+
+struct Fixture {
+  int day, month, year;
+  int lunarDay, lunarMonth, lunarYear;
+  bool leap;
+};
+
+// Published reference dates, independent of the implementation:
+// Tet 2007 (Vietnam: Feb 17; Hong Kong: Feb 18):
+// https://baochinhphu.vn/10-su-kien-noi-bat-trong-nganh-thong-tin-va-truyen-thong-10215590.htm
+// https://www.hko.gov.hk/en/wxinfo/pastwx/mws200702.htm
+// Tet 2024:
+// https://thanglong.chinhphu.vn/ha-noi-khach-du-lich-quoc-te-tang-truong-manh-trong-dip-tet-nguyen-dan-103240211232705811.htm
+// Lunar month starts in 2025, including leap month 6:
+// https://github.com/hnthap/lunar.h/tree/585a41e7a84f86f32b14bef8b614f2e46a844525#usage
+// Mid-Autumn 2025 (Oct 6 = lunar Aug 15), school event record:
+// https://thlinhdong.hcm.edu.vn/tin-tuc-su-kien/sang-thu-hai-ngay-06-thang-10-nam-2025-cac-ban-hoc-sinh-truong-tieu-hoc-linh-do/ctmb/23570/1325109
+// Tet 2026: Ministry of Home Affairs, 9441/TB-BNV (Oct 16, 2025).
+// Feb 16 = lunar Dec 29, Feb 20 = lunar Jan 4:
+// https://static3.luatvietnam.vn/uploaded/vietlawfile/2025/12/15/9441tbbnv_2025incompdf_155836.pdf
+static const Fixture fixtures[] = {
+    {16, 2, 2007, 29, 12, 2006, false},
+    {17, 2, 2007, 1, 1, 2007, false},
+    {18, 2, 2007, 2, 1, 2007, false},
+    {9, 2, 2024, 30, 12, 2023, false},
+    {10, 2, 2024, 1, 1, 2024, false},
+    {28, 1, 2025, 29, 12, 2024, false},
+    {29, 1, 2025, 1, 1, 2025, false},
+    {28, 2, 2025, 1, 2, 2025, false},
+    {29, 3, 2025, 1, 3, 2025, false},
+    {28, 4, 2025, 1, 4, 2025, false},
+    {27, 5, 2025, 1, 5, 2025, false},
+    {25, 6, 2025, 1, 6, 2025, false},
+    {24, 7, 2025, 30, 6, 2025, false},
+    {25, 7, 2025, 1, 6, 2025, true},
+    {30, 7, 2025, 6, 6, 2025, true},
+    {22, 8, 2025, 29, 6, 2025, true},
+    {23, 8, 2025, 1, 7, 2025, false},
+    {22, 9, 2025, 1, 8, 2025, false},
+    {6, 10, 2025, 15, 8, 2025, false},
+    {21, 10, 2025, 1, 9, 2025, false},
+    {20, 11, 2025, 1, 10, 2025, false},
+    {20, 12, 2025, 1, 11, 2025, false},
+    {19, 1, 2026, 1, 12, 2025, false},
+    {16, 2, 2026, 29, 12, 2025, false},
+    {17, 2, 2026, 1, 1, 2026, false},
+    {20, 2, 2026, 4, 1, 2026, false},
+};
+
+int main() {
+  for (const auto &fixture : fixtures) {
+    const auto date = VietnameseLunar::fromSolar(fixture.day, fixture.month, fixture.year);
+    if (!date.valid || date.day != fixture.lunarDay || date.month != fixture.lunarMonth ||
+        date.year != fixture.lunarYear || date.leap != fixture.leap) {
+      std::fprintf(stderr, "%04d-%02d-%02d: expected %d/%d/%d leap=%d; got %d/%d/%d leap=%d\n",
+                   fixture.year, fixture.month, fixture.day, fixture.lunarDay, fixture.lunarMonth,
+                   fixture.lunarYear, fixture.leap, date.day, date.month, date.year, date.leap);
+      return EXIT_FAILURE;
+    }
+  }
+
+  const int invalid[][3] = {{0, 1, 2026}, {32, 1, 2026}, {29, 2, 1900}, {29, 2, 2025},
+                           {31, 4, 2026}, {1, 0, 2026},  {1, 13, 2026}, {1, 1, 1899},
+                           {1, 1, 2100}, {1, 1, -1}};
+  for (const auto &input : invalid) {
+    const auto date = VietnameseLunar::fromSolar(input[0], input[1], input[2]);
+    assert(!date.valid && date.day == 0 && date.month == 0 && date.year == 0 && !date.leap);
+  }
+  assert(VietnameseLunar::fromSolar(29, 2, 2000).valid);
+  assert(VietnameseLunar::fromSolar(29, 2, 2024).valid);
+
+  // All supported civil dates must form consecutive 29/30-day lunar months.
+  VietnameseLunar::LunarDate previous = {0, 0, 0, false, false};
+  int checked = 0;
+  for (int year = 1900; year <= 2099; ++year) {
+    for (int month = 1; month <= 12; ++month) {
+      for (int day = 1; day <= VietnameseLunar::detail::daysInMonth(month, year); ++day) {
+        const auto date = VietnameseLunar::fromSolar(day, month, year);
+        if (!date.valid || date.day < 1 || date.day > 30 || date.month < 1 || date.month > 12) {
+          std::fprintf(stderr, "Invalid output at %04d-%02d-%02d: %d/%d/%d leap=%d\n", year,
+                       month, day, date.day, date.month, date.year, date.leap);
+          return EXIT_FAILURE;
+        }
+        if (previous.valid) {
+          if (date.day == 1) {
+            assert(previous.day == 29 || previous.day == 30);
+            assert(date.month == (date.leap ? previous.month : previous.month % 12 + 1));
+            assert(date.year == previous.year + (date.month == 1 && !date.leap ? 1 : 0));
+          } else {
+            assert(date.day == previous.day + 1 && date.month == previous.month &&
+                   date.year == previous.year && date.leap == previous.leap);
+          }
+        }
+        previous = date;
+        ++checked;
+      }
+    }
+  }
+  std::printf("PASS: %zu dated fixtures, %zu invalid dates, %d consecutive civil days (UTC+7).\n",
+              sizeof(fixtures) / sizeof(fixtures[0]), sizeof(invalid) / sizeof(invalid[0]), checked);
+}
