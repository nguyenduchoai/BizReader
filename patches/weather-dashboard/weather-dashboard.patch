@@ -0,0 +1,163 @@
+#pragma once
+
+/*
+ * Vietnamese solar-to-lunar calendar, fixed UTC+07:00, Gregorian 1900..2099.
+ * Adapted from hnthap/lunar.h, src/lunar.c, commit
+ * 585a41e7a84f86f32b14bef8b614f2e46a844525:
+ * https://github.com/hnthap/lunar.h
+ * Astronomical algorithm by Ho Ngoc Duc, based on Jean Meeus:
+ * https://www.informatik.uni-leipzig.de/~duc/amlich/calrules.html
+ * This adaptation has no heap allocation, OS clock, or network dependency.
+ *
+ * MIT License
+ * Copyright (c) 2024 Huynh Nhan Thap
+ *
+ * Permission is hereby granted, free of charge, to any person obtaining a copy
+ * of this software and associated documentation files (the "Software"), to deal
+ * in the Software without restriction, including without limitation the rights
+ * to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
+ * copies of the Software, and to permit persons to whom the Software is
+ * furnished to do so, subject to the following conditions:
+ * The above copyright notice and this permission notice shall be included in all
+ * copies or substantial portions of the Software.
+ * THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
+ * IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
+ * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
+ * AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
+ * LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
+ * OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
+ * SOFTWARE.
+ */
+
+#include <cmath>
+
+namespace VietnameseLunar {
+
+struct LunarDate {
+  int day;
+  int month;
+  int year;
+  bool leap;
+  bool valid;
+};
+
+namespace detail {
+constexpr double kPi = 3.1415926535898;
+constexpr double kRadians = kPi / 180.0;
+constexpr double kTimezone = 7.0;
+
+inline bool isLeapYear(int year) {
+  return year % 400 == 0 || (year % 4 == 0 && year % 100 != 0);
+}
+
+inline int daysInMonth(int month, int year) {
+  static const int days[] = {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
+  return days[month - 1] + (month == 2 && isLeapYear(year) ? 1 : 0);
+}
+
+inline int julianDay(int day, int month, int year) {
+  const int a = (14 - month) / 12;
+  const int y = year + 4800 - a;
+  const int m = month + 12 * a - 3;
+  return day + (153 * m + 2) / 5 + 365 * y + y / 4 - y / 100 + y / 400 - 32045;
+}
+
+inline int newMoonDay(int k) {
+  const double t = k / 1236.85;
+  const double t2 = t * t;
+  const double t3 = t2 * t;
+  const double jd = 2415020.75933 + 29.53058868 * k + 0.0001178 * t2 -
+                    0.000000155 * t3 +
+                    0.00033 * std::sin((166.56 + 132.87 * t - 0.009173 * t2) * kRadians);
+  const double m = 359.2242 + 29.10535608 * k - 0.0000333 * t2 - 0.00000347 * t3;
+  const double mp = 306.0253 + 385.81691806 * k + 0.0107306 * t2 + 0.00001236 * t3;
+  const double f = 21.2964 + 390.67050646 * k - 0.0016528 * t2 - 0.00000239 * t3;
+  const double correction =
+      (0.1734 - 0.000393 * t) * std::sin(m * kRadians) +
+      0.0021 * std::sin(2 * m * kRadians) - 0.4068 * std::sin(mp * kRadians) +
+      0.0161 * std::sin(2 * mp * kRadians) - 0.0004 * std::sin(3 * mp * kRadians) +
+      0.0104 * std::sin(2 * f * kRadians) - 0.0051 * std::sin((m + mp) * kRadians) -
+      0.0074 * std::sin((m - mp) * kRadians) +
+      0.0004 * std::sin((2 * f + m) * kRadians) -
+      0.0004 * std::sin((2 * f - m) * kRadians) -
+      0.0006 * std::sin((2 * f + mp) * kRadians) +
+      0.0010 * std::sin((2 * f - mp) * kRadians) +
+      0.0005 * std::sin((2 * mp + m) * kRadians);
+  const double delta = t < -11
+                           ? 0.001 + 0.000839 * t + 0.0002261 * t2 - 0.00000845 * t3 -
+                                 0.000000081 * t3 * t
+                           : -0.000278 + 0.000265 * t + 0.000262 * t2;
+  return static_cast<int>(std::floor(jd + correction - delta + 0.5 + kTimezone / 24.0));
+}
+
+inline int sunLongitudeSector(int jd) {
+  const double t = (jd - 2451545.5 - kTimezone / 24.0) / 36525.0;
+  const double t2 = t * t;
+  const double m = 357.52910 + 35999.05030 * t - 0.0001559 * t2 - 0.00000048 * t2 * t;
+  const double mean = 280.46645 + 36000.76983 * t + 0.0003032 * t2;
+  const double correction =
+      (1.914600 - 0.004817 * t - 0.000014 * t2) * std::sin(m * kRadians) +
+      (0.019993 - 0.000101 * t) * std::sin(2 * m * kRadians) +
+      0.000290 * std::sin(3 * m * kRadians);
+  double longitude = (mean + correction) * kRadians;
+  longitude -= 2 * kPi * std::floor(longitude / (2 * kPi));
+  return static_cast<int>(std::floor(longitude / kPi * 6));
+}
+
+inline int monthElevenStart(int year) {
+  const int k = static_cast<int>(std::floor((julianDay(31, 12, year) - 2415021) / 29.530588853));
+  const int start = newMoonDay(k);
+  return sunLongitudeSector(start) >= 9 ? newMoonDay(k - 1) : start;
+}
+
+inline int leapMonthOffset(int monthEleven) {
+  const int k = static_cast<int>(std::floor((monthEleven - 2415021.076998695) / 29.530588853 + 0.5));
+  int i = 1;
+  int sector = sunLongitudeSector(newMoonDay(k + 1));
+  int previous;
+  do {
+    previous = sector;
+    ++i;
+    sector = sunLongitudeSector(newMoonDay(k + i));
+  } while (sector != previous && i < 14);
+  return i - 1;
+}
+}  // namespace detail
+
+// The input must already be the local civil date in Vietnam, not a UTC date.
+inline LunarDate fromSolar(int day, int month, int year) {
+  if (year < 1900 || year > 2099 || month < 1 || month > 12 || day < 1 ||
+      day > detail::daysInMonth(month, year)) {
+    return {0, 0, 0, false, false};
+  }
+  const int jd = detail::julianDay(day, month, year);
+  int k = static_cast<int>(std::floor((jd - 2415021.076998695) / 29.530588853));
+  int monthStart = detail::newMoonDay(k);
+  // A mean synodic month only estimates k; bracket the actual local new moon.
+  while (monthStart > jd) monthStart = detail::newMoonDay(--k);
+  while (detail::newMoonDay(k + 1) <= jd) monthStart = detail::newMoonDay(++k);
+  int a = detail::monthElevenStart(year);
+  int b = a;
+  int lunarYear;
+  if (a >= monthStart) {
+    lunarYear = year;
+    a = detail::monthElevenStart(year - 1);
+  } else {
+    lunarYear = year + 1;
+    b = detail::monthElevenStart(year + 1);
+  }
+  const int difference = (monthStart - a) / 29;
+  int lunarMonth = difference + 11;
+  bool leap = false;
+  if (b - a > 365) {
+    const int offset = detail::leapMonthOffset(a);
+    if (difference >= offset) {
+      lunarMonth = difference + 10;
+      leap = difference == offset;
+    }
+  }
+  if (lunarMonth > 12) lunarMonth -= 12;
+  if (lunarMonth >= 11 && difference < 4) --lunarYear;
+  return {jd - monthStart + 1, lunarMonth, lunarYear, leap, true};
+}
+}  // namespace VietnameseLunar
