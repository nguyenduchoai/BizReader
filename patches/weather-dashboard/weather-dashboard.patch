+#pragma once
+
+#include <array>
+#include <cassert>
+#include <cstdint>
+#include <vector>
+
+class TwoWire {
+ public:
+  std::array<uint8_t, 16> registers{};
+  std::vector<uint8_t> writtenRegisters;
+  bool acknowledged = true;
+  bool shortRead = false;
+  bool started = false;
+
+  bool begin(int sda, int scl, int frequency) {
+    assert(sda == 18 && scl == 17 && frequency == 100000);
+    started = true;
+    return true;
+  }
+
+  void setTimeOut(int milliseconds) { assert(milliseconds == 50); }
+  void beginTransmission(uint8_t address) {
+    assert(address == 0x51);
+    transfer.clear();
+  }
+  void write(uint8_t byte) { transfer.push_back(byte); }
+  int endTransmission(bool = true) {
+    if (!acknowledged) return 2;
+    assert(!transfer.empty());
+    cursor = transfer[0];
+    for (size_t i = 1; i < transfer.size(); ++i) {
+      writtenRegisters.push_back(cursor);
+      registers[cursor++] = transfer[i];
+    }
+    return 0;
+  }
+  uint8_t requestFrom(uint8_t address, uint8_t count, uint8_t) {
+    assert(address == 0x51);
+    return shortRead ? count - 1 : count;
+  }
+  uint8_t read() { return registers[cursor++]; }
+
+ private:
+  std::vector<uint8_t> transfer;
+  uint8_t cursor = 0;
+};
+
+extern TwoWire Wire;
