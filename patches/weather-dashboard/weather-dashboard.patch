+        sendError(400, "Tên thành phố không hợp lệ hoặc quá dài. Hãy nhập lại.");
+        return false;
+    }
+    if (country.length() != 2 || country[0] < 'A' || country[0] > 'Z' || country[1] < 'A' || country[1] > 'Z') {
+        sendError(400, "Mã quốc gia gồm hai chữ cái, ví dụ VN.");
+        return false;
+    }
+    if (!validHostname(ntp)) {
+        sendError(400, "Máy chủ NTP không hợp lệ. Có thể dùng 0.asia.pool.ntp.org.");
+        return false;
+    }
+    const bool openWifi = server.arg("open_wifi") == "1";
+    if (!openWifi && !password.isEmpty() &&
+        ((password.length() < 8 || password.length() > 63) && !(password.length() == 64 && isHex(password)))) {
+        sendError(400, "Mật khẩu Wi-Fi cần từ 8 đến 63 ký tự, hoặc 64 ký tự hex.");
+        return false;
+    }
+    if (!password.isEmpty() && hasControlCharacters(password)) {
+        sendError(400, "Mật khẩu Wi-Fi chứa ký tự không hợp lệ. Hãy nhập lại.");
+        return false;
+    }
+    if (!apiKey.isEmpty() && (apiKey.length() != 32 || !isHex(apiKey))) {
+        sendError(400, "Khoá OpenWeather cần đủ 32 ký tự hex. Kiểm tra lại khoá API.");
+        return false;
+    }
+    if (apiKey.isEmpty() && String(doc["OpenWeather"]["apikey"] | "").isEmpty()) {
+        sendError(400, "Chưa có khoá OpenWeather. Hãy nhập khoá API để lấy thời tiết.");
+        return false;
+    }
+    if (!openWifi && password.isEmpty() && String(doc["WLAN"]["password"] | "").isEmpty()) {
+        sendError(400, "Hãy nhập mật khẩu hoặc chọn Wi-Fi không có mật khẩu.");
+        return false;
+    }
+
+    doc["WLAN"]["ssid"] = ssid;
+    if (openWifi) doc["WLAN"]["password"] = "";
+    else if (!password.isEmpty()) doc["WLAN"]["password"] = password;
+    if (!apiKey.isEmpty()) doc["OpenWeather"]["apikey"] = apiKey;
+    doc["OpenWeather"]["city"] = city;
+    doc["OpenWeather"]["country"] = country;
+    doc["OpenWeather"]["server"] = "api.openweathermap.org";
+    doc["OpenWeather"]["hemisphere"] = "north";
+    doc["OpenWeather"]["units"] = "M";
+    doc["ntp"]["server"] = ntp;
+    doc["ntp"]["timezone"] = "ICT-7";
+    if (doc.overflowed()) {
+        sendError(400, "Cấu hình quá lớn. Chưa thay đổi dữ liệu đã lưu.");
+        return false;
+    }
+
+    const size_t expected = measureJson(doc);
+    std::unique_ptr<char[]> serialized(new (std::nothrow) char[expected + 1]);
+    if (!serialized || serializeJson(doc, serialized.get(), expected + 1) != expected) {
+        sendError(500, "Không đủ bộ nhớ để lưu cấu hình. Hãy thử lại.");
+        return false;
+    }
+    File file = SPIFFS.open("/config.tmp", FILE_WRITE);
+    if (!file) {
+        sendError(500, "Không ghi được cấu hình. Kiểm tra dung lượng bộ nhớ thiết bị.");
+        return false;
+    }
+    const size_t written = file.write(reinterpret_cast<const uint8_t*>(serialized.get()), expected);
+    file.flush();
+    file.close();
+    // SPIFFS may report the writer's cached size until close. Verify persisted
+    // JSON through a fresh handle, including every unknown setting and secret.
+    File persisted = SPIFFS.open("/config.tmp", FILE_READ);
+    bool complete = written == expected && persisted && persisted.size() == expected;
+    size_t offset = 0;
+    uint8_t chunk[128];
+    while (complete && offset < expected) {
+        const size_t count = expected - offset < sizeof(chunk) ? expected - offset : sizeof(chunk);
+        complete = persisted.read(chunk, count) == count &&
+                   memcmp(chunk, serialized.get() + offset, count) == 0;
+        offset += count;
+    }
+    persisted.close();
+    if (!complete) {
+        SPIFFS.remove("/config.tmp");
+        sendError(500, "Ghi cấu hình chưa hoàn tất. Cài đặt cũ vẫn được giữ nguyên.");
+        return false;
+    }
+    SPIFFS.remove("/config.bak");
+    if (!SPIFFS.rename("/config.json", "/config.bak")) {
+        SPIFFS.remove("/config.tmp");
+        sendError(500, "Không tạo được bản dự phòng. Cài đặt cũ vẫn được giữ nguyên.");
+        return false;
+    }
+    if (!SPIFFS.rename("/config.tmp", "/config.json")) {
+        SPIFFS.rename("/config.bak", "/config.json");
+        sendError(500, "Không thay được tệp cấu hình. Hãy thử lưu lại.");
+        return false;
+    }
+    SPIFFS.remove("/config.bak");
+    return true;
+}
 
