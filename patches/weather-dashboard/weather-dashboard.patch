@@ -0,0 +1,161 @@
+#include "../weather_state.h"
+
+#include <algorithm>
+#include <cassert>
+#include <cerrno>
+#include <cstdio>
+#include <cstring>
+#include <map>
+#include <memory>
+#include <new>
+#include <string>
+#include <vector>
+
+constexpr const char* FILE_WRITE = "w";
+constexpr const char* FILE_READ = "r";
+WeatherState::Cache weatherCache;
+
+enum Fault { None, ReopenFailure, CorruptedRead, WrongReadSize, ShortRead, DifferentSnapshot };
+Fault fault = None;
+int writeHandleSizeCalls = 0;
+int openWriters = 0;
+int renameCount = 0;
+std::string failure;
+
+struct File {
+  std::vector<uint8_t>* data = nullptr;
+  bool writer = false;
+
+  explicit operator bool() const { return data != nullptr; }
+
+  size_t write(const uint8_t* bytes, size_t count) {
+    data->assign(bytes, bytes + count);
+    return count;
+  }
+
+  // Reproduce the observed SDK behavior without treating leftover errno as failure.
+  void flush() { errno = 88; }
+
+  void close() {
+    if (data && writer) --openWriters;
+    data = nullptr;
+  }
+
+  size_t size() const {
+    if (writer) {
+      ++writeHandleSizeCalls;
+      return 0;
+    }
+    return data->size() - (fault == WrongReadSize ? 1 : 0);
+  }
+
+  size_t read(uint8_t* bytes, size_t count) {
+    count = std::min(count, data->size());
+    if (fault == ShortRead) --count;
+    std::memcpy(bytes, data->data(), count);
+    if (fault == CorruptedRead) bytes[50] ^= 1;
+    if (fault == DifferentSnapshot) {
+      auto& candidate = *reinterpret_cast<WeatherState::Cache*>(bytes);
+      candidate.current.temperature += 1;
+      WeatherState::seal(candidate);
+    }
+    return count;
+  }
+};
+
+struct FakeFS {
+  std::map<std::string, std::vector<uint8_t>> files;
+
+  File open(const char* path, const char* mode) {
+    File result;
+    result.writer = mode[0] == 'w';
+    if (!result.writer) {
+      assert(openWriters == 0);
+      if (fault == ReopenFailure && std::string(path) == "/weather.tmp") {
+        errno = EIO;
+        return result;
+      }
+    } else {
+      files[path].clear();
+      ++openWriters;
+    }
+    auto found = files.find(path);
+    if (found != files.end()) result.data = &found->second;
+    return result;
+  }
+
+  bool exists(const char* path) { return files.count(path); }
+  bool remove(const char* path) { return files.erase(path); }
+
+  bool rename(const char* from, const char* to) {
+    ++renameCount;
+    if (!files.count(from) || files.count(to)) return false;
+    files[to] = files[from];
+    files.erase(from);
+    return true;
+  }
+} SPIFFS;
+
+struct FakeSerial {
+  template <typename... T>
+  void printf(const char*, T...) {}
+} Serial;
+
+inline bool CacheSaveFailure(const char* stage) {
+  failure = stage;
+  return false;
+}
+
+// check_cache_persistence.py appends the actual implementation to this translation unit.
+inline bool SaveWeatherCache();
+
+int main() {
+  WeatherState::clear(weatherCache);
+  weatherCache.lastSuccess = weatherCache.lastAttempt = 1791072000;
+  weatherCache.forecastCount = WeatherState::kForecastCount;
+  WeatherState::Reading reading = {};
+  reading.dt = 1791072000;
+  reading.temperature = reading.feelsLike = 30;
+  reading.low = 25;
+  reading.high = 35;
+  reading.pressure = 1000;
+  reading.humidity = 50;
+  reading.conditionCode = 800;
+  std::memcpy(reading.icon, "01d", 4);
+  weatherCache.current = reading;
+  for (size_t i = 0; i < WeatherState::kForecastCount; ++i) {
+    reading.dt += 10800;
+    weatherCache.forecast[i] = reading;
+  }
+  WeatherState::seal(weatherCache);
+  assert(WeatherState::hasWeather(weatherCache));
+
+  const std::vector<uint8_t> old = {1, 2, 3};
+  const std::vector<uint8_t> config = {9, 8, 7};
+  const Fault cases[] = {None, ReopenFailure, CorruptedRead, WrongReadSize, ShortRead, DifferentSnapshot};
+  for (const Fault test : cases) {
+    fault = test;
+    SPIFFS.files.clear();
+    SPIFFS.files["/weather.bin"] = old;
+    SPIFFS.files["/config.json"] = config;
+    failure.clear();
+    renameCount = 0;
+    const bool saved = SaveWeatherCache();
+    assert(openWriters == 0);
+    assert(SPIFFS.files["/config.json"] == config);
+    if (fault == None) {
+      assert(saved && failure.empty());
+      const auto& actual = SPIFFS.files["/weather.bin"];
+      assert(actual.size() == sizeof(weatherCache));
+      assert(std::memcmp(actual.data(), &weatherCache, sizeof(weatherCache)) == 0);
+      assert(renameCount == 2);
+    } else {
+      assert(!saved && !failure.empty());
+      assert(SPIFFS.files["/weather.bin"] == old);
+      assert(renameCount == 0);
+    }
+  }
+  assert(writeHandleSizeCalls == 0);
+  std::puts("PASS: stale writer metadata ignored; close/reopen verified; five read-back failures "
+            "preserve the old cache and configuration (ASan/UBSan).");
+}
diff --git a/tests/weather_rtc_test.cpp b/tests/weather_rtc_test.cpp
new file mode 100644
index 0000000..d9f210b
--- /dev/null
+++ b/tests/weather_rtc_test.cpp
@@ -0,0 +1,75 @@
+#include "../weather_rtc.h"
+
+#include <cassert>
+#include <cstdio>
+#include <cstdlib>
+
+TwoWire Wire;
+
+int main() {
+  TwoWire bus;
+  WeatherRtc rtc(bus);
+  time_t result = 123;
+  assert(!rtc.readUtc(result));
+  assert(rtc.begin());
+  assert(bus.started && bus.writtenRegisters.empty());
+
+  // Date conversion remains UTC even with Vietnam's timezone configured.
+  setenv("TZ", "ICT-7", 1);
+  tzset();
+  const time_t expected = 1791072000;  // 2026-10-04 00:00:00 UTC.
+  assert(rtc.writeUtc(expected));
+  assert(bus.registers[4] == 0x00 && bus.registers[5] == 0x04);
+  assert(bus.registers[7] == 0x10 && bus.registers[8] == 0x26);
+  assert(rtc.readUtc(result) && result == expected);
+  struct tm localDate;
+  assert(localtime_r(&result, &localDate) && localDate.tm_hour == 7);
+  for (uint8_t address : bus.writtenRegisters) assert(address >= 2 && address <= 8);
+
+  // Invalid data must not replace the caller's previous timestamp.
+  bus.registers[2] = 0x80;
+  result = 123;
+  assert(!rtc.readUtc(result) && result == 123);
+  bus.registers[2] = 0x6a;
+  assert(!rtc.readUtc(result));
+  assert(rtc.writeUtc(expected));
+  bus.registers[5] = 0x31;
+  bus.registers[7] = 0x04;
+  assert(!rtc.readUtc(result));
+  bus.registers[5] = 0x29;
+  bus.registers[7] = 0x02;
+  bus.registers[8] = 0x26;
+  assert(!rtc.readUtc(result));
+  bus.registers[8] = 0x24;
+  assert(rtc.readUtc(result) && result == 1709164800);  // Leap day.
+  bus.registers[7] |= 0x80;
+  assert(!rtc.readUtc(result));
+  assert(rtc.writeUtc(expected));
+  bus.registers[6] = 7;
+  assert(!rtc.readUtc(result));
+
+  // Explicit time sync recovers a stopped clock, without touching IRQ state.
+  assert(rtc.writeUtc(expected));
+  bus.registers[0] = 0x20;
+  bus.registers[1] = 0x0b;
+  bus.registers[0x0d] = 0x83;
+  assert(!rtc.readUtc(result));
+  bus.writtenRegisters.clear();
+  assert(rtc.writeUtc(expected));
+  assert(bus.registers[0] == 0 && bus.registers[1] == 0x0b && bus.registers[0x0d] == 0x83);
+  for (uint8_t address : bus.writtenRegisters) assert(address == 0 || (address >= 2 && address <= 8));
+  assert(rtc.readUtc(result) && result == expected);
+  assert(!rtc.writeUtc(0));
+  assert(!rtc.writeUtc(static_cast<time_t>(4102444800LL)));
+
+  bus.shortRead = true;
+  assert(!rtc.readUtc(result));
+  bus.shortRead = false;
+  bus.acknowledged = false;
+  assert(!rtc.readUtc(result) && !rtc.writeUtc(expected));
+  TwoWire missingBus;
+  missingBus.acknowledged = false;
+  WeatherRtc missingRtc(missingBus);
+  assert(!missingRtc.begin());
+  puts("Weather RTC tests passed");
+}
diff --git a/tests/weather_state_test.cpp b/tests/weather_state_test.cpp
new file mode 100644
index 0000000..573efd3
--- /dev/null
+++ b/tests/weather_state_test.cpp
@@ -0,0 +1,256 @@
+#include "../weather_state.h"
+
+#include <cassert>
+#include <cstdio>
+#include <limits>
+
+using WeatherState::Cache;
+using WeatherState::Reading;
+
+static constexpr std::int64_t kNow = 1791072000LL;
+
+static Reading reading(std::int64_t timestamp) {
+  Reading value = {};
+  value.dt = static_cast<std::uint32_t>(timestamp);
+  value.sunrise = static_cast<std::uint32_t>(timestamp - 4 * 3600);
+  value.sunset = static_cast<std::uint32_t>(timestamp + 8 * 3600);
+  value.temperature = 31.7F;
+  value.feelsLike = 36.5F;
+  value.high = 33.0F;
+  value.low = 26.0F;
+  value.humidity = 73.0F;
+  value.pressure = 1006.0F;
+  value.windDirection = 140.0F;
+  value.windSpeed = 3.4F;
+  value.pop = 0.7F;
+  value.conditionCode = 801;
+  value.cloudCover = 20;
+  value.visibility = 10000;
+  value.timezone = 7 * 3600;
+  std::memcpy(value.icon, "02d", sizeof(value.icon));
+  return value;
+}
+
+static Cache populated(std::int64_t now = kNow) {
+  Cache cache;
+  WeatherState::clear(cache);
+  cache.lastSuccess = now;
+  cache.lastAttempt = now;
+  cache.locationHash = 0x1234ABCDU;
+  cache.forecastCount = WeatherState::kForecastCount;
+  cache.current = reading(now);
+  for (std::size_t index = 0; index < WeatherState::kForecastCount; ++index) {
+    cache.forecast[index] = reading(now + (index + 1) * 3 * 3600);
+    cache.forecast[index].sunrise = 0;
+    cache.forecast[index].sunset = 0;
+  }
+  WeatherState::seal(cache);
+  assert(WeatherState::hasWeather(cache));
+  return cache;
+}
+
+static void testIntegrity() {
+  Cache empty;
+  std::memset(&empty, 0xFF, sizeof(empty));
+  assert(!WeatherState::valid(empty));
+  WeatherState::clear(empty);
+  assert(WeatherState::valid(empty));
+  assert(empty.locationHash == 0);
+  assert(!WeatherState::hasWeather(empty));
+  assert(WeatherState::isStale(empty, kNow));
+  assert(WeatherState::shouldFetch(empty, kNow));
+
+  const Cache good = populated();
+  Cache damaged = good;
+  damaged.current.temperature += 1.0F;
+  assert(!WeatherState::valid(damaged));
+  damaged = good;
+  damaged.forecast[23].icon[2] = 'n';
+  assert(!WeatherState::valid(damaged));
+  damaged = good;
+  ++damaged.lastAttempt;
+  assert(!WeatherState::valid(damaged));
+  damaged = good;
+  damaged.locationHash ^= 1;
+  assert(!WeatherState::valid(damaged));
+  WeatherState::seal(damaged);
+  assert(WeatherState::valid(damaged));
+  assert(damaged.locationHash != good.locationHash);
+  damaged = good;
+  damaged.checksum ^= 1;
+  assert(!WeatherState::valid(damaged));
+  assert(WeatherState::isStale(damaged, kNow));
+  assert(WeatherState::shouldFetch(damaged, kNow));
+
+  damaged = good;
+  ++damaged.magic;
+  WeatherState::seal(damaged);
+  assert(!WeatherState::valid(damaged));
+  damaged = good;
+  ++damaged.version;
+  WeatherState::seal(damaged);
+  assert(!WeatherState::valid(damaged));
+  damaged = good;
+  --damaged.forecastCount;
+  WeatherState::seal(damaged);
+  assert(!WeatherState::valid(damaged));
+  damaged = good;
+  damaged.forecastCount = 0;
+  WeatherState::seal(damaged);
+  assert(!WeatherState::valid(damaged));
+
+  // Raw persistence round-trips the POD cache without constructors or pointers.
+  unsigned char persisted[sizeof(Cache)];
+  std::memcpy(persisted, &good, sizeof(good));
+  Cache restored;
+  std::memcpy(&restored, persisted, sizeof(restored));
+  assert(WeatherState::hasWeather(restored));
+  assert(restored.current.temperature == good.current.temperature);
+  assert(restored.forecast[23].dt == good.forecast[23].dt);
+  assert(restored.locationHash == good.locationHash);
+}
+
+static void testDataValidation() {
+  using FloatField = float Reading::*;
+  const FloatField fields[] = {
+      &Reading::temperature, &Reading::feelsLike, &Reading::high,          &Reading::low,
+      &Reading::humidity,    &Reading::pressure,  &Reading::windDirection, &Reading::windSpeed,
+      &Reading::rain,        &Reading::snow,      &Reading::pop,
+  };
+  for (const auto field : fields) {
+    Cache bad = populated();
+    bad.current.*field = std::numeric_limits<float>::quiet_NaN();
+    WeatherState::seal(bad);
+    assert(!WeatherState::valid(bad));
+    bad = populated();
+    bad.forecast[23].*field = std::numeric_limits<float>::infinity();
+    WeatherState::seal(bad);
+    assert(!WeatherState::valid(bad));
+  }
+
+  const auto rejects = [](const Cache& cache) {
+    Cache sealed = cache;
+    WeatherState::seal(sealed);
+    assert(!WeatherState::valid(sealed));
+  };
+  Cache bad = populated();
+  bad.current.humidity = 101.0F;
+  rejects(bad);
+  bad = populated();
+  bad.current.pressure = 0.0F;
+  rejects(bad);
+  bad = populated();
+  bad.forecast[0].pop = 70.0F;
+  rejects(bad);
+  bad = populated();
+  bad.current.low = bad.current.high + 1.0F;
+  rejects(bad);
+  bad = populated();
+  bad.current.icon[3] = 'x';
+  rejects(bad);
+  bad = populated();
+  bad.current.icon[0] = '9';
+  rejects(bad);
+  bad = populated();
+  bad.current.dt = 0;
+  rejects(bad);
+  bad = populated();
+  bad.current.sunrise = 100;
+  rejects(bad);
+  bad = populated();
+  bad.forecast[1].dt = bad.forecast[0].dt;
+  rejects(bad);
+  bad = populated();
+  bad.forecast[23].dt = bad.forecast[0].dt;
+  rejects(bad);
+  bad = populated();
+  bad.lastSuccess = 0;
+  rejects(bad);
+  bad = populated();
+  bad.lastAttempt = -1;
+  rejects(bad);
+
+  const char* icons[] = {"01d", "02n", "03d", "04n", "09d", "10n", "11d", "13n", "50d"};
+  for (const char* icon : icons) {
+    Cache good = populated();
+    std::memcpy(good.current.icon, icon, 4);
+    WeatherState::seal(good);
+    assert(WeatherState::valid(good));
+  }
+}
+
+static void testSchedule() {
+  Cache cache = populated();
+  assert(!WeatherState::isStale(cache, kNow));
+  assert(!WeatherState::shouldFetch(cache, kNow));
+  assert(!WeatherState::shouldFetch(cache, kNow + 3599));
+  assert(!WeatherState::isStale(cache, kNow + 3599));
+  assert(WeatherState::shouldFetch(cache, kNow + 3600));
+  assert(WeatherState::isStale(cache, kNow + 3600));
+  assert(WeatherState::shouldFetch(cache, kNow, true));
+
+  cache.lastAttempt = kNow + 3600;
+  WeatherState::seal(cache);
+  assert(WeatherState::isStale(cache, kNow + 3601));
+  assert(!WeatherState::shouldFetch(cache, kNow + 3601));
+  assert(!WeatherState::shouldFetch(cache, kNow + 4499));
+  assert(WeatherState::shouldFetch(cache, kNow + 4500));
+  assert(WeatherState::shouldFetch(cache, kNow + 3601, true));
+
+  WeatherState::clear(cache);
+  cache.lastAttempt = kNow;
+  WeatherState::seal(cache);
+  assert(WeatherState::valid(cache));
+  assert(!WeatherState::shouldFetch(cache, kNow));
+  assert(!WeatherState::shouldFetch(cache, kNow + 899));
+  assert(WeatherState::shouldFetch(cache, kNow + 900));
+
+  // A restored clock must not interpret negative elapsed time as fresh weather.
+  cache = populated();
+  assert(WeatherState::isStale(cache, kNow - 1));
+  assert(WeatherState::shouldFetch(cache, kNow - 1));
+  cache.lastAttempt = kNow + 100;
+  WeatherState::seal(cache);
+  assert(WeatherState::isStale(cache, kNow));
+  assert(WeatherState::shouldFetch(cache, kNow));
+  assert(WeatherState::shouldFetch(cache, 0));
+  assert(WeatherState::isStale(cache, 0));
+  assert(WeatherState::shouldFetch(cache, std::numeric_limits<std::int64_t>::min()));
+  assert(WeatherState::isStale(cache, std::numeric_limits<std::int64_t>::max()));
+
+  // Readings and timestamp subtraction also work after the signed-32-bit boundary.
+  cache = populated(2147483648LL + 3600);
+  assert(!WeatherState::shouldFetch(cache, cache.lastSuccess + 3599));
+  assert(WeatherState::shouldFetch(cache, cache.lastSuccess + 3600));
+  assert(!WeatherState::validEpoch(WeatherState::kFirstEpoch - 1));
+  assert(WeatherState::validEpoch(WeatherState::kFirstEpoch));
+  assert(WeatherState::validEpoch(WeatherState::kLastEpoch));
+  assert(!WeatherState::validEpoch(WeatherState::kLastEpoch + 1));
+}
+
+static void testMinuteBoundary() {
+  assert(WeatherState::secondsUntilNextMinute(0) == 60);
+  assert(WeatherState::secondsUntilNextMinute(1) == 59);
+  assert(WeatherState::secondsUntilNextMinute(59) == 1);
+  assert(WeatherState::secondsUntilNextMinute(60) == 60);
+  assert(WeatherState::secondsUntilNextMinute(kNow) == 60);
+  assert(WeatherState::secondsUntilNextMinute(kNow + 45) == 15);
+  assert(WeatherState::secondsUntilNextMinute(-1) == 1);
+  assert(WeatherState::secondsUntilNextMinute(-60) == 60);
+  assert(WeatherState::secondsUntilNextMinute(std::numeric_limits<std::int64_t>::min()) >= 1);
+  assert(WeatherState::secondsUntilNextMinute(std::numeric_limits<std::int64_t>::max()) <= 60);
+  for (std::int64_t now = kNow - 121; now <= kNow + 121; ++now) {
+    const auto delay = WeatherState::secondsUntilNextMinute(now);
+    assert(delay >= 1 && delay <= 60);
+    assert((now + delay) % 60 == 0);
+  }
+}
+
+int main() {
+  testIntegrity();
+  testDataValidation();
+  testSchedule();
+  testMinuteBoundary();
+  std::printf("PASS: weather cache integrity, values, hourly/retry schedule and minute boundaries; %zu RTC bytes.\n",
+              sizeof(Cache));
+}
diff --git a/weather_dashboard.h b/weather_dashboard.h
