+#!/usr/bin/env python3
+"""Compile actual sketch display functions for a deterministic native preview.
+
+No credentials, network code, device upload, or handwritten UI mock is used.
+The fonts are the sketch's actual compressed glyphs. Hardware-only calls use
+host.hpp stubs; primitive rasterization can differ by one pixel from ESP32.
+"""
+from pathlib import Path
+import re
+import subprocess
+import sys
+
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parent.parent
+source = (ROOT / 'LilyGo-EPD-4-7-OWM-Weather-Display.ino').read_text()
+
+def function(name):
+    match = re.search(r'^([\w\s:*]+\b' + re.escape(name) + r'\([^;]*?\))\s*\{', source, re.M)
+    if not match:
+        raise ValueError(name)
+    start = match.start()
+    pos = source.index('{', match.start())
+    depth = 1
+    end = pos + 1
+    # These sketch routines have no unmatched brace literals.
+    while depth:
+        if source[end] == '{': depth += 1
+        if source[end] == '}': depth -= 1
+        end += 1
+    return source[start:end].strip()
+
+display_start = source.index('void DisplayWeather()')
+display_end = source.find('#include "weather_dashboard.h"', display_start)
+display = source[display_start:display_end if display_end >= 0 else len(source)]
+helpers = '\n'.join(function(name) for name in ('ConvertUnixTime', 'JulianDate', 'SumOfPrecip', 'TitleCase', 'NormalizedMoonPhase'))
+prototypes = '\n'.join(m.group(1).strip()+';' for m in re.finditer(r'^((?:void|bool|boolean|String|double|float|int)\s+\w+\([^;{}]*?\))\s*\{', helpers+'\n'+display, re.M))
+globals_source = source[source.index('#define SCREEN_WIDTH'):source.index('RTC_DATA_ATTR bool weatherDisplayed')]
+extra_headers = []
+for name in re.findall(r'^#include "([^"]+)"', source, re.M):
+    if name.startswith('opensans') or name in (
+        'web.h', 'forecast_record.h', 'owm_credentials.h', 'lang.h',
+        'weather_runtime.h', 'weather_dashboard.h',
+    ):
+        continue
+    if (ROOT/name).exists():
+        extra_headers.append('#include "'+name+'"')
+
+generated = '#include "host.hpp"\n#include "forecast_record.h"\n#include "lang.h"\n'+ '\n'.join(extra_headers)+'\n'+globals_source+'\n'
+generated += 'String City="Ho Chi Minh City", Units="M", Hemisphere="north";\n'
+generated += prototypes+'\n'+helpers+'\n'+display+'\n#include "fixture.hpp"\n'
+(HERE/'generated.inc').write_text(generated)
+subprocess.run(['clang++','-x','c++','-std=c++17','-g','-fsanitize=address,undefined','-fno-omit-frame-pointer','-I'+str(HERE),'-I'+str(ROOT),str(HERE/'generated.inc'),'-lz','-o',str(HERE/'weather-preview')],check=True)
+subprocess.run([str(HERE/'weather-preview'),str(HERE/(sys.argv[1] if len(sys.argv)>1 else 'weather.pgm'))],check=True)
