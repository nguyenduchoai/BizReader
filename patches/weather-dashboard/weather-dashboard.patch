new file mode 100644
index 0000000..e3f7b16
--- /dev/null
+++ b/weather_state.h
@@ -0,0 +1,200 @@
+#ifndef WEATHER_STATE_H_
+#define WEATHER_STATE_H_
+
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <type_traits>
+
+namespace WeatherState {
+
+constexpr std::uint32_t kMagic = 0x57544852U;
+constexpr std::uint32_t kVersion = 2;
+constexpr std::size_t kForecastCount = 24;
+constexpr std::int64_t kRefreshSeconds = 60 * 60;
+constexpr std::int64_t kRetrySeconds = 15 * 60;
+constexpr std::int64_t kFirstEpoch = 1577836800LL;  // 2020-01-01 UTC.
+constexpr std::int64_t kLastEpoch = 4102444799LL;   // 2099-12-31 UTC.
+
+// Epochs are UTC; physical values use metric OWM units, including wind in m/s.
+struct Reading {
+  std::uint32_t dt;
+  std::uint32_t sunrise;
+  std::uint32_t sunset;
+  float temperature;
+  float feelsLike;
+  float high;
+  float low;
+  float humidity;
+  float pressure;
+  float windDirection;
+  float windSpeed;
+  float rain;
+  float snow;
+  float pop;
+  std::int32_t conditionCode;
+  std::int32_t cloudCover;
+  std::int32_t visibility;
+  std::int32_t timezone;
+  char icon[4];
+};
+
+// Use clear() before filling a new cache. No heap pointers survive deep sleep.
+struct Cache {
+  std::uint32_t magic;
+  std::uint32_t version;
+  std::uint32_t forecastCount;
+  std::uint32_t checksum;
+  std::int64_t lastSuccess;
+  std::int64_t lastAttempt;
+  std::uint32_t locationHash;
+  Reading current;
+  Reading forecast[kForecastCount];
+};
+
+static_assert(std::is_trivial<Cache>::value && std::is_standard_layout<Cache>::value,
+              "RTC weather cache must remain POD");
+static_assert(sizeof(Cache) <= 4096, "Leave RTC memory for the clock and display state");
+
+inline bool validEpoch(std::int64_t value) { return value >= kFirstEpoch && value <= kLastEpoch; }
+
+namespace detail {
+
+inline void hashBytes(std::uint32_t& hash, const void* value, std::size_t size) {
+  const auto* bytes = static_cast<const unsigned char*>(value);
+  for (std::size_t index = 0; index < size; ++index) {
+    hash = (hash ^ bytes[index]) * 16777619U;
+  }
+}
+
+template <typename T>
+inline void hashValue(std::uint32_t& hash, const T& value) {
+  hashBytes(hash, &value, sizeof(value));
+}
+
+inline void hashReading(std::uint32_t& hash, const Reading& reading) {
+  hashValue(hash, reading.dt);
+  hashValue(hash, reading.sunrise);
+  hashValue(hash, reading.sunset);
+  hashValue(hash, reading.temperature);
+  hashValue(hash, reading.feelsLike);
+  hashValue(hash, reading.high);
+  hashValue(hash, reading.low);
+  hashValue(hash, reading.humidity);
+  hashValue(hash, reading.pressure);
+  hashValue(hash, reading.windDirection);
+  hashValue(hash, reading.windSpeed);
+  hashValue(hash, reading.rain);
+  hashValue(hash, reading.snow);
+  hashValue(hash, reading.pop);
+  hashValue(hash, reading.conditionCode);
+  hashValue(hash, reading.cloudCover);
+  hashValue(hash, reading.visibility);
+  hashValue(hash, reading.timezone);
+  hashBytes(hash, reading.icon, sizeof(reading.icon));
+}
+
+// Hash fields, not the struct representation: compiler padding is not data.
+inline std::uint32_t checksum(const Cache& cache) {
+  std::uint32_t hash = 2166136261U;
+  hashValue(hash, cache.magic);
+  hashValue(hash, cache.version);
+  hashValue(hash, cache.forecastCount);
+  hashValue(hash, cache.lastSuccess);
+  hashValue(hash, cache.lastAttempt);
+  hashValue(hash, cache.locationHash);
+  hashReading(hash, cache.current);
+  for (const auto& reading : cache.forecast) {
+    hashReading(hash, reading);
+  }
+  return hash;
+}
+
+inline bool inRange(float value, float minimum, float maximum) {
+  return std::isfinite(value) && value >= minimum && value <= maximum;
+}
+
+inline bool validIcon(const char (&icon)[4]) {
+  if (icon[3] != '\0' || (icon[2] != 'd' && icon[2] != 'n')) {
+    return false;
+  }
+  return (icon[0] == '0' && (icon[1] == '1' || icon[1] == '2' || icon[1] == '3' || icon[1] == '4' || icon[1] == '9')) ||
+         (icon[0] == '1' && (icon[1] == '0' || icon[1] == '1' || icon[1] == '3')) || (icon[0] == '5' && icon[1] == '0');
+}
+
+inline bool validReading(const Reading& reading) {
+  return validEpoch(reading.dt) && (reading.sunrise == 0 || validEpoch(reading.sunrise)) &&
+         (reading.sunset == 0 || validEpoch(reading.sunset)) && inRange(reading.temperature, -100.0F, 100.0F) &&
+         inRange(reading.feelsLike, -100.0F, 100.0F) && inRange(reading.high, -100.0F, 100.0F) &&
+         inRange(reading.low, -100.0F, 100.0F) && reading.low <= reading.high &&
+         inRange(reading.humidity, 0.0F, 100.0F) && inRange(reading.pressure, 300.0F, 1200.0F) &&
+         inRange(reading.windDirection, 0.0F, 360.0F) && inRange(reading.windSpeed, 0.0F, 150.0F) &&
+         inRange(reading.rain, 0.0F, 1000.0F) && inRange(reading.snow, 0.0F, 1000.0F) &&
+         inRange(reading.pop, 0.0F, 1.0F) &&
+         (reading.conditionCode == 0 || (reading.conditionCode >= 200 && reading.conditionCode <= 804)) &&
+         reading.cloudCover >= 0 && reading.cloudCover <= 100 && reading.visibility >= 0 &&
+         reading.visibility <= 100000 && reading.timezone >= -14 * 3600 && reading.timezone <= 14 * 3600 &&
+         validIcon(reading.icon);
+}
+
+}  // namespace detail
+
+inline void seal(Cache& cache) { cache.checksum = detail::checksum(cache); }
+
+inline void clear(Cache& cache) {
+  std::memset(&cache, 0, sizeof(cache));
+  cache.magic = kMagic;
+  cache.version = kVersion;
+  seal(cache);
+}
+
+// A sealed empty cache is valid so a failed first fetch can retain its retry time.
+inline bool valid(const Cache& cache) {
+  if (cache.magic != kMagic || cache.version != kVersion || cache.checksum != detail::checksum(cache) ||
+      (cache.lastAttempt != 0 && !validEpoch(cache.lastAttempt))) {
+    return false;
+  }
+  if (cache.forecastCount == 0) {
+    return cache.lastSuccess == 0;
+  }
+  if (cache.forecastCount != kForecastCount || !validEpoch(cache.lastSuccess) || !detail::validReading(cache.current)) {
+    return false;
+  }
+  std::uint32_t previous = 0;
+  for (const auto& reading : cache.forecast) {
+    if (!detail::validReading(reading) || reading.dt <= previous) {
+      return false;
+    }
+    previous = reading.dt;
+  }
+  return true;
+}
+
+inline bool hasWeather(const Cache& cache) { return valid(cache) && cache.forecastCount == kForecastCount; }
+
+inline bool isStale(const Cache& cache, std::int64_t now) {
+  return !validEpoch(now) || !hasWeather(cache) || cache.lastSuccess > now || cache.lastAttempt > now ||
+         now - cache.lastSuccess >= kRefreshSeconds;
+}
+
+inline bool shouldFetch(const Cache& cache, std::int64_t now, bool force = false) {
+  if (force || !validEpoch(now) || !valid(cache) || cache.lastSuccess > now || cache.lastAttempt > now) {
+    return true;
+  }
+  if (cache.lastAttempt != 0 && now - cache.lastAttempt < kRetrySeconds) {
+    return false;
+  }
+  return cache.forecastCount == 0 || now - cache.lastSuccess >= kRefreshSeconds;
+}
+
+// An exact minute boundary waits a full minute, never immediately wakes again.
+inline std::uint32_t secondsUntilNextMinute(std::int64_t now) {
+  const std::int64_t remainder = now % 60;
+  const std::int64_t normalized = remainder < 0 ? remainder + 60 : remainder;
+  return static_cast<std::uint32_t>(60 - normalized);
+}
+
+}  // namespace WeatherState
+
+#endif  // WEATHER_STATE_H_
