+#!/usr/bin/env python3
+"""Check dashboard margins, all icons, stale states, calendars and clock isolation."""
+from datetime import datetime, timezone, timedelta
+from pathlib import Path
+import os
+import subprocess
+import sys
+
+HERE = Path(__file__).resolve().parent
+VIETNAM = timezone(timedelta(hours=7))
+cases = []
+conditions = {"01": 800, "02": 801, "03": 802, "04": 804, "09": 521, "10": 501,
+              "11": 211, "13": 601, "50": 741}
+for icon, condition in conditions.items():
+    for suffix in ("d", "n"):
+        cases.append((icon + suffix, {"PREVIEW_ICON": icon + suffix, "PREVIEW_CONDITION": str(condition)}))
+cases.extend([
+    ("clock-only", {"PREVIEW_CLOCK_TEST": "1"}),
+    ("stale", {"PREVIEW_STALE": "1"}),
+    ("fresh-before-hour", {"PREVIEW_AGE": "3599"}),
+    ("stale-at-hour", {"PREVIEW_AGE": "3600"}),
+    ("stale-after-hour", {"PREVIEW_AGE": "3601"}),
+    ("fetch-failed", {"PREVIEW_FAILED": "1"}),
+    ("clock-unset", {"PREVIEW_NO_RTC": "1"}),
+    ("offline", {"PREVIEW_NO_WEATHER": "1"}),
+    ("offline-clock-unset", {"PREVIEW_NO_WEATHER": "1", "PREVIEW_NO_RTC": "1"}),
+    ("long-city", {"PREVIEW_LONG_CITY": "1"}),
+    ("extreme", {"PREVIEW_EXTREME": "1"}),
+])
+for label, date in (
+    ("six-rows", (2026, 8, 31, 23, 59)),
+    ("leap-day", (2024, 2, 29, 12, 59)),
+    ("lunar-leap-month", (2025, 7, 25, 8, 8)),
+    ("tet", (2026, 2, 17, 6, 0)),
+    ("full-moon", (2026, 9, 25, 18, 30)),
+    ("year-end", (2026, 12, 31, 23, 59)),
+    ("year-start", (2027, 1, 1, 0, 0)),
+):
+    cases.append((label, {"PREVIEW_EPOCH": str(int(datetime(*date, tzinfo=VIETNAM).timestamp()))}))
+
+failed = []
+for label, overrides in cases:
+    result = subprocess.run(
+        [str(HERE / "dashboard-preview"), str(HERE / ("dashboard-" + label + ".pgm"))],
+        env=dict(os.environ, **overrides), text=True, capture_output=True,
+    )
+    print(f"{label}: {result.stdout.strip()}")
+    if result.returncode or "Missing glyph" in result.stderr:
+        failed.append(label)
+        print(result.stderr, file=sys.stderr)
+print(f"{len(cases) - len(failed)}/{len(cases)} dashboard cases passed")
+sys.exit(bool(failed))
