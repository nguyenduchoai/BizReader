+            attributes = termios.tcgetattr(slave)
+            attributes[2] |= termios.HUPCL
+            attributes[3] &= ~(termios.ICANON | termios.ECHO)
+            termios.tcsetattr(slave, termios.TCSANOW, attributes)
+            os.write(master, b"pending boot log\n")
+            forbidden = {termios.TIOCMBIS, termios.TIOCMBIC, termios.TIOCMSET}
+            original_ioctl = serial.serialposix.fcntl.ioctl
+
+            def checked_ioctl(fd, request, *args):
+                self.assertNotIn(request, forbidden)
+                return original_ioctl(fd, request, *args)
+
+            with mock.patch.object(serial.serialposix.fcntl, "ioctl", side_effect=checked_ioctl):
+                device = PassiveSerial(port=None, baudrate=115200, timeout=0.2,
+                                       rtscts=False, dsrdtr=False)
+                device.port = os.ttyname(slave)
+                device.open()
+                self.assertFalse(termios.tcgetattr(device.fd)[2] & termios.HUPCL)
+                device.dtr = False
+                device.rts = False
+                device.dtr = True
+                device.rts = True
+                self.assertEqual(device.read(17), b"pending boot log\n")
+                with self.assertRaises(serial.SerialException):
+                    device.write(b"must not send")
+                device.close()
+                self.assertFalse(device.is_open)
+        finally:
+            if device is not None:
+                device.close()
+            os.close(master)
+            os.close(slave)
+
+    def test_bounded_reconnect_closes_every_handle_without_modem_setters(self):
+        elapsed = [0.0]
+        ports = []
+        messages = []
+
+        class Port:
+            def __init__(self, **kwargs):
+                self.number = len(ports)
+                self.closed = False
+                self.reads = 0
+                ports.append(self)
+
+            def __setattr__(self, name, value):
+                if name in ("dtr", "rts"):
+                    raise AssertionError("Monitor must leave modem lines untouched")
+                super().__setattr__(name, value)
+
+            def open(self):
+                pass
+
+            @property
+            def in_waiting(self):
+                return 1024
+
+            def read(self, size):
+                self.reads += 1
+                if self.number == 0:
+                    return (b"tick1\nT\xc3", b"\xadch\r\npartial")[self.reads - 1]
+                if self.number == 1:
+                    if self.reads == 1:
+                        return b"tick2"
+                    raise serial.SerialException("USB disconnected")
+                return b"tick3\n"
+
+            def close(self):
+                self.closed = True
+
+        def sleep(seconds):
+            self.assertGreater(seconds, 0)
+            self.assertLessEqual(seconds, 0.05)
+            elapsed[0] += seconds
+
+        connections, byte_count = monitor(
+            "/dev/mock", 0.3, lambda *message: messages.append(message),
+            serial_factory=Port, port_exists=lambda _: not 0.09 <= elapsed[0] < 0.14,
+            now=lambda: elapsed[0], sleep=sleep)
+        self.assertEqual(connections, 3)
+        self.assertGreater(byte_count, 0)
+        self.assertTrue(all(port.closed for port in ports))
+        self.assertAlmostEqual(elapsed[0], 0.3)
+        self.assertIn(("serial", "T\u00edch"), messages)
+        self.assertIn(("serial-partial", "partial"), messages)
+        self.assertIn(("serial-partial", "tick2"), messages)
+        self.assertIn(("serial", "tick3"), messages)
+
+    def test_invalid_duration_is_rejected(self):
+        for value in ("nan", "inf", "-1", "0"):
+            with self.subTest(value=value), self.assertRaises(argparse.ArgumentTypeError):
+                positive_seconds(value)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/weather_cache_persistence_fixture.cpp b/tests/weather_cache_persistence_fixture.cpp
